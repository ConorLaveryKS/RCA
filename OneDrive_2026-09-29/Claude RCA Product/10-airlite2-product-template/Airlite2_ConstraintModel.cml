        {"1050", "2700", 1.76}, {"1050", "3000", 1.97}, {"1050", "3300", 2.18}, {"1050", "3600", 2.39},
        {"1100", "1200", 0.80}, {"1100", "1500", 1.01}, {"1100", "1800", 1.22}, {"1100", "2100", 1.43},
        {"1100", "2400", 1.64}, {"1100", "2700", 1.85}, {"1100", "3000", 2.07}, {"1100", "3300", 2.29},
        {"1100", "3600", 2.51}, {"1150", "1200", 0.84}, {"1150", "1500", 1.05}, {"1150", "1800", 1.27},
        {"1150", "2100", 1.49}, {"1150", "2400", 1.71}, {"1150", "2700", 1.94}, {"1150", "3000", 2.17},
        {"1150", "3300", 2.40}, {"1150", "3600", 2.63}, {"1200", "1200", 0.88}, {"1200", "1500", 1.10},
        {"1200", "1800", 1.33}, {"1200", "2100", 1.56}, {"1200", "2400", 1.79}, {"1200", "2700", 2.03},
        {"1200", "3000", 2.27}, {"1200", "3300", 2.51}, {"1200", "3600", 2.75}, {"1250", "1200", 0.92},
        {"1250", "1500", 1.15}, {"1250", "1800", 1.39}, {"1250", "2100", 1.63}, {"1250", "2400", 1.87},
        {"1250", "2700", 2.12}, {"1250", "3000", 2.37}, {"1250", "3300", 2.62}, {"1250", "3600", 2.87},
        {"1300", "1200", 0.95}, {"1300", "1500", 1.20}, {"1300", "1800", 1.45}, {"1300", "2100", 1.70},
        {"1300", "2400", 1.95}, {"1300", "2700", 2.20}, {"1300", "3000", 2.46}, {"1300", "3300", 2.72},
        {"1300", "3600", 2.99}, {"1350", "1200", 0.99}, {"1350", "1500", 1.25}, {"1350", "1800", 1.51},
        {"1350", "2100", 1.77}, {"1350", "2400", 2.03}, {"1350", "2700", 2.29}, {"1350", "3000", 2.56},
        {"1350", "3300", 2.83}, {"1350", "3600", 3.11}, {"1400", "1200", 1.03}, {"1400", "1500", 1.29},
        {"1400", "1800", 1.56}, {"1400", "2100", 1.83}, {"1400", "2400", 2.10}, {"1400", "2700", 2.38},
        {"1400", "3000", 2.66}, {"1400", "3300", 2.94}, {"1400", "3600", 3.23}, {"1450", "1200", 1.07},
        {"1450", "1500", 1.34}, {"1450", "1800", 1.62}, {"1450", "2100", 1.90}, {"1450", "2400", 2.18},
        {"1450", "2700", 2.47}, {"1450", "3000", 2.76}, {"1450", "3300", 3.05}, {"1450", "3600", 3.35},
        {"1500", "1200", 1.11}, {"1500", "1500", 1.39}, {"1500", "1800", 1.68}, {"1500", "2100", 1.97},
        {"1500", "2400", 2.26}, {"1500", "2700", 2.56}, {"1500", "3000", 2.86}, {"1500", "3300", 3.16},
        {"1500", "3600", 3.47}, {"1550", "1200", 1.15}, {"1550", "1500", 1.44}, {"1550", "1800", 1.74},
        {"1550", "2100", 2.04}, {"1550", "2400", 2.34}, {"1550", "2700", 2.65}, {"1550", "3000", 2.96},
        {"1550", "3300", 3.27}, {"1550", "3600", 3.59}, {"1600", "1200", 1.19}, {"1600", "1500", 1.49},
        {"1600", "1800", 1.80}, {"1600", "2100", 2.11}, {"1600", "2400", 2.42}, {"1600", "2700", 2.74},
        {"1600", "3000", 3.06}, {"1600", "3300", 3.39}, {"1600", "3600", 3.72}, {"1650", "1200", 1.23},
        {"1650", "1500", 1.54}, {"1650", "1800", 1.86}, {"1650", "2100", 2.18}, {"1650", "2400", 2.50},
        {"1650", "2700", 2.83}, {"1650", "3000", 3.17}, {"1650", "3300", 3.50}, {"1650", "3600", 3.84},
        {"1700", "1200", 1.27}, {"1700", "1500", 1.59}, {"1700", "1800", 1.92}, {"1700", "2100", 2.25},
        {"1700", "2400", 2.58}, {"1700", "2700", 2.92}, {"1700", "3000", 3.27}, {"1700", "3300", 3.61},
        {"1700", "3600", 3.97}, {"1750", "1200", 1.31}, {"1750", "1500", 1.64}, {"1750", "1800", 1.98},
        {"1750", "2100", 2.32}, {"1750", "2400", 2.67}, {"1750", "2700", 3.02}, {"1750", "3000", 3.37},
        {"1750", "3300", 3.73}, {"1750", "3600", 4.09}, {"1800", "1200", 1.34}, {"1800", "1500", 1.69},
        {"1800", "1800", 2.04}, {"1800", "2100", 2.39}, {"1800", "2400", 2.75}, {"1800", "2700", 3.11},
        {"1800", "3000", 3.47}, {"1800", "3300", 3.84}, {"1800", "3600", 4.21}, {"1850", "1200", 1.38},
        {"1850", "1500", 1.74}, {"1850", "1800", 2.10}, {"1850", "2100", 2.46}, {"1850", "2400", 2.83},
        {"1850", "2700", 3.20}, {"1850", "3000", 3.57}, {"1850", "3300", 3.95}, {"1850", "3600", 4.34},
        {"1900", "1200", 1.42}, {"1900", "1500", 1.79}, {"1900", "1800", 2.16}, {"1900", "2100", 2.53},
        {"1900", "2400", 2.91}, {"1900", "2700", 3.29}, {"1900", "3000", 3.68}, {"1900", "3300", 4.06},
        {"1900", "3600", 4.46}, {"1950", "1200", 1.46}, {"1950", "1500", 1.84}, {"1950", "1800", 2.22},
        {"1950", "2100", 2.60}, {"1950", "2400", 2.99}, {"1950", "2700", 3.38}, {"1950", "3000", 3.78},
        {"1950", "3300", 4.18}, {"1950", "3600", 4.59}, {"2000", "1200", 1.50}, {"2000", "1500", 1.89},
        {"2000", "1800", 2.28}, {"2000", "2100", 2.67}, {"2000", "2400", 3.07}, {"2000", "2700", 3.47},
        {"2000", "3000", 3.88}, {"2000", "3300", 4.29}, {"2000", "3600", 4.71}),
        "Aerodynamic area Aa – installation E2");


    // ══════════════════════════════════════════════════════════════════════
    //  4.  CERTIFICATION RULES – Input sheet columns AH (1E) / AJ (1S)
    // ══════════════════════════════════════════════════════════════════════
    constraint((AIR_Controls2 == "P2B32" || AIR_Controls2 == "P2B40" || AIR_Controls2 == "P2B50" || AIR_Controls2 == "P2B63" || AIR_Controls2 == "P2B80" || AIR_Controls2 == "M2B24") -> AIR_Width_mm2 >= 700,
               "Min. width with 2 actuators is 700 mm.");

    constraint((AIR_Controls2 == "M1B24" || AIR_Controls2 == "M2B24" || AIR_Controls2 == "M1B230") -> AIR_ThermalRelease2 == "FX",
               "Electric controls only in combination with FX.");

    constraint(AIR_Version2 == "1E" && (AIR_Controls2 == "P1B32" || AIR_Controls2 == "P2B32" || AIR_Controls2 == "P1B40" || AIR_Controls2 == "P2B40" || AIR_Controls2 == "P1B50" || AIR_Controls2 == "P2B50" || AIR_Controls2 == "P1B63" || AIR_Controls2 == "P2B63" || AIR_Controls2 == "P1B80" || AIR_Controls2 == "P2B80") -> AIR_ThermalRelease2 != "FFX",
               "1E: pneumatic controls not with FFX.");

    constraint(AIR_Louvre2 == "GL24" -> (AIR_InstallationType2 == "A0" || AIR_InstallationType2 == "A2"),
               "GL24 is invalid by installation into wall (E1, E2).");

    constraint(AIR_BaseDesign2 == "E" -> AIR_FlangeType2 == "N5",
               "Base design E is only possible with a N5 flange.");

    constraint((AIR_InstallationType2 == "A0" || AIR_InstallationType2 == "A2") -> AIR_WindBaffle2 == "WM",
               "Flat roof installation (A0, A2) requires the movable wind baffle WM.");

    constraint((AIR_InstallationType2 == "E1" || AIR_InstallationType2 == "E2") -> AIR_WindBaffle2 == "W0",
               "No movable wind baffle required for wall installation (E1, E2).");

    constraint(AIR_Version2 == "1E" && AIR_Louvre2 != "GL24" -> AIR_Delivery2 == "CA",
               "1E: break down (BD) only in combination with glass louvres GL24.");

    constraint((AIR_Controls2 == "M1B24" || AIR_Controls2 == "M2B24") -> AIR_AmbientTemp2 == "T(-25)",
               "24 V actuators: ambient air temperature class T(-25).");

    constraint((AIR_Controls2 == "P1B32" || AIR_Controls2 == "P2B32" || AIR_Controls2 == "P1B40" || AIR_Controls2 == "P2B40" || AIR_Controls2 == "P1B50" || AIR_Controls2 == "P2B50" || AIR_Controls2 == "P1B63" || AIR_Controls2 == "P2B63" || AIR_Controls2 == "P1B80" || AIR_Controls2 == "P2B80" || AIR_Controls2 == "M1B230") -> AIR_AmbientTemp2 == "T(-15)",
               "Ambient air temperature class T(-15) for the chosen actuator.");

    // ══════════════════════════════════════════════════════════════════════
    //  5.  NUMERIC CHECKS – message() so free numbers never trigger the search limit
    // ══════════════════════════════════════════════════════════════════════
    message(AIR_MountingAngle2 < 0 || AIR_MountingAngle2 > 90,
            "Mounting angle must be between 0 and 90°.", "Error");

    message(AIR_Version2 == "1E" && (AIR_InstallationType2 == "E1" || AIR_InstallationType2 == "E2") && AIR_MountingAngle2 != 90,
            "1E: installation in wall only with mounting angle 90°.", "Error");

    message(AIR_Version2 == "1E" && AIR_Louvre2 == "GL24" && AIR_MountingAngle2 > 20,
            "1E: GL24 max. mounting angle 20°.", "Error");

    message((AIR_Controls2 == "P1B32" || AIR_Controls2 == "P2B32" || AIR_Controls2 == "P1B40" || AIR_Controls2 == "P2B40" || AIR_Controls2 == "P1B50" || AIR_Controls2 == "P2B50" || AIR_Controls2 == "P1B63" || AIR_Controls2 == "P2B63" || AIR_Controls2 == "P1B80" || AIR_Controls2 == "P2B80") && (AIR_PressureDaily2 < 6 || AIR_PressureDaily2 > 30 || AIR_PressureSmoke2 < 6 || AIR_PressureSmoke2 > 30),
            "Pressure out of the valid pressure range (min. 6 bar, max. cylinder pressure ≤ 30 bar).", "Error");

    message((AIR_ThermalRelease2 == "FFX" || AIR_ThermalRelease2 == "FF68" || AIR_ThermalRelease2 == "FF93") && (AIR_PressureDaily2 != AIR_PressureSmoke2 || AIR_PressureDaily2 > 12),
            "Failsafe: day-to-day pressure must equal smoke pressure, max. 12 bar.", "Error");

    message(AIR_Coating2 != "X" && AIR_RALColour2 == "",
            "Insert RAL colour for the selected coating.", "Warning");

    message(AIR_Coating2 != "X" && AIR_Coating2 != "W" && AIR_Width_mm2 > 1900 && AIR_Length_mm2 > 1900,
            "Coated units: the shorter side must not be larger than 1900 mm.", "Warning");

    // ══════════════════════════════════════════════════════════════════════
    //  6.  FLANGE DIMENSION LIMITS (Flanges sheet) – warnings, as in the configurator
    // ══════════════════════════════════════════════════════════════════════
    message((AIR_FlangeType2 == "N1-16" || AIR_FlangeType2 == "N1-24") && (AIR_FlangeWidth2 < AIR_Width_mm2 + 150 || AIR_FlangeWidth2 > AIR_Width_mm2 + 200 || AIR_FlangeLength2 < AIR_Length_mm2 + 150 || AIR_FlangeLength2 > AIR_Length_mm2 + 500),
            "N1 flange: width +150…+200 mm, length +150…+500 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N2" || AIR_FlangeType2 == "N3" || AIR_FlangeType2 == "N4" || AIR_FlangeType2 == "N7" || AIR_FlangeType2 == "NS") && (AIR_FlangeWidth2 < AIR_Width_mm2 + 150 || AIR_FlangeLength2 < AIR_Length_mm2 + 150),
            "Flange must be at least +150 mm on width and length. Check with the GPTS.", "Warning");

    message(AIR_FlangeType2 == "N5" && AIR_BaseDesign2 != "E" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 150 || AIR_FlangeWidth2 > AIR_Width_mm2 + 500 || AIR_FlangeLength2 < AIR_Length_mm2 + 150 || AIR_FlangeLength2 > AIR_Length_mm2 + 500),
            "N5 flange: +150…+500 mm on width and length. Check with the GPTS.", "Warning");

    message(AIR_FlangeType2 == "N5" && AIR_BaseDesign2 == "E" && (AIR_FlangeWidth2 != AIR_Width_mm2 + 250 || AIR_FlangeLength2 != AIR_Length_mm2 + 250),
            "N5 flange with base E: flange must be exactly +250 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N6 - L" || AIR_FlangeType2 == "N6 - R" || AIR_FlangeType2 == "N6 - LR" || AIR_FlangeType2 == "N6 - T" || AIR_FlangeType2 == "N6 - B" || AIR_FlangeType2 == "N6 - TB") && AIR_BaseDesign2 == "S" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 300 || AIR_FlangeLength2 < AIR_Length_mm2 + 355),
            "N6 flange with base S: min. width +300 mm, length +355 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N6 - L" || AIR_FlangeType2 == "N6 - R" || AIR_FlangeType2 == "N6 - LR" || AIR_FlangeType2 == "N6 - T" || AIR_FlangeType2 == "N6 - B" || AIR_FlangeType2 == "N6 - TB") && AIR_BaseDesign2 == "H" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 250 || AIR_FlangeLength2 < AIR_Length_mm2 + 330),
            "N6 flange with base H: min. width +250 mm, length +330 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N6 - L" || AIR_FlangeType2 == "N6 - R" || AIR_FlangeType2 == "N6 - LR" || AIR_FlangeType2 == "N6 - T" || AIR_FlangeType2 == "N6 - B" || AIR_FlangeType2 == "N6 - TB") && AIR_BaseDesign2 == "E" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 300 || AIR_FlangeLength2 < AIR_Length_mm2 + 300),
            "N6 flange with base E: min. +300 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N8 - L" || AIR_FlangeType2 == "N8 - R" || AIR_FlangeType2 == "N8 - LR" || AIR_FlangeType2 == "N8 - T" || AIR_FlangeType2 == "N8 - B" || AIR_FlangeType2 == "N8 - TB") && AIR_BaseDesign2 == "S" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 350 || AIR_FlangeLength2 < AIR_Length_mm2 + 380),
            "N8 flange with base S: min. width +350 mm, length +380 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N8 - L" || AIR_FlangeType2 == "N8 - R" || AIR_FlangeType2 == "N8 - LR" || AIR_FlangeType2 == "N8 - T" || AIR_FlangeType2 == "N8 - B" || AIR_FlangeType2 == "N8 - TB") && AIR_BaseDesign2 == "H" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 250 || AIR_FlangeLength2 < AIR_Length_mm2 + 330),
            "N8 flange with base H: min. width +250 mm, length +330 mm. Check with the GPTS.", "Warning");

    message((AIR_FlangeType2 == "N8 - L" || AIR_FlangeType2 == "N8 - R" || AIR_FlangeType2 == "N8 - LR" || AIR_FlangeType2 == "N8 - T" || AIR_FlangeType2 == "N8 - B" || AIR_FlangeType2 == "N8 - TB") && AIR_BaseDesign2 == "E" && (AIR_FlangeWidth2 < AIR_Width_mm2 + 300 || AIR_FlangeLength2 < AIR_Length_mm2 + 300),
            "N8 flange with base E: min. +300 mm. Check with the GPTS.", "Warning");


    // ══════════════════════════════════════════════════════════════════════
    //  7.  LOAD CHECKS – need the configurator's calculation sheets (Apex / factory)
    // ══════════════════════════════════════════════════════════════════════
    message((AIR_Controls2 == "P1B32" || AIR_Controls2 == "P2B32" || AIR_Controls2 == "P1B40" || AIR_Controls2 == "P2B40" || AIR_Controls2 == "P1B50" || AIR_Controls2 == "P2B50" || AIR_Controls2 == "P1B63" || AIR_Controls2 == "P2B63" || AIR_Controls2 == "P1B80" || AIR_Controls2 == "P2B80") && AIR_ThermalRelease2 != "FX" && AIR_ThermalRelease2 != "FFX",
            "Pneumatic with thermal release: CO2 bottle (min. 20 g) and cylinder size to be confirmed from the configurator.", "Info");

    message(AIR_SnowLoad2 > 0,
            "Snow load: max. SL of cylinder / motor to be checked in the Airlite configurator (SL sheets).", "Info");

    message(AIR_Version2 == "1E" && AIR_WindLoad2 > 0,
            "1E: wind suction load to be checked in the Airlite configurator (Windload sheet).", "Info");
}
