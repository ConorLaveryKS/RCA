// ═══════════════════════════════════════════════════════════════════════════
//  ECO Roof Ventilator CO – Constraint Model (CML)
//  Nextview Consulting | Revenue Cloud Advanced Configurator
//  Version 2.0 – Syntax-validated against Salesforce CML User Guide
//
//  CHANGES FROM v1.0  (validation fixes):
//    [F1]  @(readOnly = true) is not a CML annotation → replaced with
//          @(configurable = false)
//    [F2]  String method .startsWith() not supported in CML → expanded to
//          explicit OR conditions for every M* / FS* / FV* code
//    [F3]  String concatenation & in message() text not supported →
//          merged into single string literals
//    [F4]  require(attr_expr, attr_expr, "msg") is invalid – require() only
//          accepts relation[Type] as second arg → replaced with
//          constraint(cond -> cond, "msg")
//    [F5]  exclude(cond, attr_expr, "msg") is invalid – exclude() only
//          accepts relation[Type] as second arg → replaced with
//          constraint(cond -> attr_constraint, "msg")
//    [F6]  Unicode → replaced with ASCII -> for implication operator
//    [F7]  Chained action rules on AerodynamicAreaAa (guard reduction on top
//          of Cv value) conflicts because CML action rules are declarative,
//          not sequential → combined Cv × guard factor into single expression
//          per condition branch
//    [F8]  constraint(condition -> table(...)) mixed implication/table fixed:
//          UValue table now uses a standalone constraint; CB* covered by
//          separate action rule already; implication removed
//    [F9]  Action rule for Weight triggers message(Weight == "X") but Weight
//          is always "X" – message condition simplified to true
//    [F10] ROUND() function usage kept; documented as needing validation
//          in org – fallback to direct arithmetic if not supported
// ═══════════════════════════════════════════════════════════════════════════

// ── Global constants ────────────────────────────────────────────────────────
const int     LOUVRE_PITCH_MM    = 133;   // fixed louvre pitch (mm)
const int     LOUVRE_EDGE_OFFSET = 40;    // dead-band edge offset (mm)
const decimal MIN_OPEN_PRESSURE  = 2.0;   // minimum opening pressure (bar)


// ═══════════════════════════════════════════════════════════════════════════
//  TYPE: ECO Roof Ventilator CO
//  Association → Product2.ProductCode = "CO"
// ═══════════════════════════════════════════════════════════════════════════
type CO {

    // ──────────────────────────────────────────────────────────────────────
    //  INPUT ATTRIBUTES  (configured by user on the quote)
    // ──────────────────────────────────────────────────────────────────────
    @(defaultValue = "3E")
    string Version = ["3E","3S","2V","3D"];

    @(defaultValue = "15")
    string ThroatWidth = [
        "6","7","9","10","12","13","15","16","18","19","21","22","23","25"];

    @(defaultValue = "15")
    string ThroatLength = [
        "10","11","13","14","15","17","18","19","21","22","23","25",
        "26","27","29","30","31","32","34","35","36","38"];

    @(defaultValue = "POR")
    string LouvreType = [
        "A1B","A1X","A2BD","A2XD","A2B","A2X","A2I",
        "PCR","POR","PC16","PO16","GWR","GLR","GTR"];

    @(defaultValue = "P1BD")
    string Control = [
        "HE","HI","L",
        "P1O","P2O","P1C","P2C","P1O4","P2O4","P1C4","P2C4",
        "P1BD","P2BD","P1OSH","P2OSH","P1OSP","P2OSP",
        "P1BDD","P2BDD","P1OSHD","P2OSHD","P1OSPD","P2OSPD",
        "M1B24","M2B24","M1C24","M2C24","M1O24","M2O24",
        "M1B24M","M2B24M","M1C24J","M2C24J","M1B24K","M2B24K",
        "M1B230","M2B230","M1C230","M2C230","M1O230","M2O230",
        "M1B230J","M2B230J","M1C230J","M2C230J",
        "MP1OSH","MP2OSH","MP1OSP","MP2OSP","M1B24J","M2B24J"];

    @(defaultValue = "FS68")
    string ThermalRelease = [
        "FX","F72","F93","F141","F182","F72S","F93S","F141S","F182S",
        "1F72","1F93","1F141","1F182","1F72S","1F93S","1F141S","1F182S",
        "2F72","2F93","2F141","2F182","2F72S","2F93S","2F141S","2F182S",
        "FV68","FV93","FS68","FS93","FS141","FS182",
        "FS68S","FS93S","FS141S","FS182S"];

    @(defaultValue = "T(-15)")
    string AmbientTemp = ["X","T(00)","T(-05)","T(-15)","T(-25)"];

    @(defaultValue = "X")
    string RemovableLouvre = ["X","R"];

    @(defaultValue = "X")
    string Insulation = ["X","I"];

    @(defaultValue = "STD")
    string BaseType = ["STD","CB2","CB3","CB4","UB1","UB2","UB3","UB4","UB5"];

    @(defaultValue = "N5")
    string FlangeEdgeType = [
        "N1-D","N1-D4","N1-U","N1-U4","N1-16","N1-24","N1-AZ","N2","N3","N4","N5",
        "N6-L","N6-R","N6-LR","N6-T","N6-B","N6-TB","N7",
        "N8-L","N8-R","N8-LR","N8-T","N8-B","N8-TB",
        "N9-D","N9-U","N10","N11","NS"];

    @(defaultValue = "X")
    string InsulatedAdapter = ["X","A"];

    @(defaultValue = "X")
    string Guards = ["X","IG","IS","BG"];

    @(defaultValue = "X")
    string BurglarGuards = ["X","S"];

    @(defaultValue = "X")
    string Finish = ["X","S","PG","PS","PM"];

    @(defaultValue = "X")
    string Coverage = ["X","P","C"];

    string RALColour;

    @(defaultValue = "X")
    string UpstandDesign = ["X","S250","S350","C250","C350"];

    @(defaultValue = "F")
    string AssemblySituation = ["F","W","S"];

    @(defaultValue = "No")
    string LiftingEyes = ["No","Yes"];


    // ──────────────────────────────────────────────────────────────────────
    //  INTERNAL PROXY VARIABLES
    //  [F1] @(hidden = true) is the correct CML annotation for UI-invisible vars
    // ──────────────────────────────────────────────────────────────────────
    @(hidden = true)
    int ThroatWidth_mm;

    @(hidden = true)
    int ThroatLength_mm;

    @(hidden = true)
    int ReleaseTemperature_int;


    // ──────────────────────────────────────────────────────────────────────
    //  OUTPUT ATTRIBUTES  (calculated, not user-editable)
    //  [F1] @(readOnly = true) is NOT a valid CML annotation.
    //       Correct annotation is @(configurable = false)
    // ──────────────────────────────────────────────────────────────────────

    @(configurable = false)
    int NumberOfLouvres;

    @(configurable = false)
    decimal GeometricAreaAv;

    @(configurable = false)
    decimal AerodynamicAreaAa;

    @(configurable = false)
    string SnowLoad;

    @(configurable = false)
    string WindLoad;

    @(configurable = false)
    string AmbientTempClass;

    @(configurable = false)
    int ReleaseTemperature;

    @(configurable = false)
    string OpeningPressureVent;

    @(configurable = false)
    string OpeningPressureSmoke;

    @(configurable = false)
    string CO2Bottle;

    @(configurable = false)
    string Weight;

    @(configurable = false)
    string UValue;


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 1 – THROAT CODE → MM MAPPING
    //  constraint(table(...)) – valid CML; maps picklist code to integer mm
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ThroatWidth, ThroatWidth_mm,
        {"6",  426},  {"7",  576},  {"9",  726},  {"10", 876},
        {"12", 1026}, {"13", 1176}, {"15", 1326}, {"16", 1476},
        {"18", 1626}, {"19", 1776}, {"21", 1926}, {"22", 2000},
        {"23", 2126}, {"25", 2326}),
        "ThroatWidth code to mm");

    constraint(table(ThroatLength, ThroatLength_mm,
        {"10", 705},  {"11", 838},  {"13", 971},  {"14", 1104},
        {"15", 1237}, {"17", 1370}, {"18", 1503}, {"19", 1636},
        {"21", 1769}, {"22", 1902}, {"23", 2035}, {"25", 2168},
        {"26", 2301}, {"27", 2434}, {"29", 2567}, {"30", 2700},
        {"31", 2833}, {"32", 2966}, {"34", 3099}, {"35", 3232},
        {"36", 3365}, {"38", 3498}),
        "ThroatLength code to mm");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 2 – NUMBER OF LOUVRES
    //  action(condition, variable = expression) – valid CML syntax
    //  Integer division (truncating) from (Length_mm - 40) / 133
    // ══════════════════════════════════════════════════════════════════════
    action(true, NumberOfLouvres = (ThroatLength_mm - LOUVRE_EDGE_OFFSET) / LOUVRE_PITCH_MM);


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 3 – GEOMETRIC AREA Av (m²)
    //  [F10] ROUND() – assumed supported; replace with direct division if not
    // ══════════════════════════════════════════════════════════════════════
    action(true, GeometricAreaAv = ROUND((ThroatWidth_mm * ThroatLength_mm) / 1000000.0, 2));


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 4 – AERODYNAMIC AREA Aa (m²)
    //
    //  [F7] FIXED: v1.0 had two separate action rules:
    //    (a) action(LouvreType == "A1B", AerodynamicAreaAa = GeometricAreaAv * 0.60)
    //    (b) action(Guards == "BG",      AerodynamicAreaAa = AerodynamicAreaAa * 0.95)
    //  These conflict because CML action rules are declarative, not sequential:
    //  rule (b) references AerodynamicAreaAa which is also set by (a) – circular.
    //
    //  FIX: Compute combined Cv × guard factor in one expression per branch.
    //  Cv factors:  A1*/A2* aluminium → 0.60/0.65/0.72
    //               PC*/PO* 9mm      → 0.62
    //               PC16/PO16        → 0.60
    //               G*               → 0.60/0.58
    //  Guard reduction: BG → ×0.95, IS → ×0.84, IG → ×0.75, X → ×1.00
    //
    //  16 action rules (4 louvre families × 4 guard options), all mutually exclusive
    // ══════════════════════════════════════════════════════════════════════

    // ── A1* louvres (Cv = 0.60) ──
    action((LouvreType == "A1B" || LouvreType == "A1X") && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60, 2));
    action((LouvreType == "A1B" || LouvreType == "A1X") && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.95, 2));
    action((LouvreType == "A1B" || LouvreType == "A1X") && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.84, 2));
    action((LouvreType == "A1B" || LouvreType == "A1X") && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.75, 2));

    // ── A2* aluminium louvres (Cv = 0.65) ──
    action((LouvreType == "A2BD" || LouvreType == "A2XD" ||
            LouvreType == "A2B"  || LouvreType == "A2X") && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.65, 2));
    action((LouvreType == "A2BD" || LouvreType == "A2XD" ||
            LouvreType == "A2B"  || LouvreType == "A2X") && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.65 * 0.95, 2));
    action((LouvreType == "A2BD" || LouvreType == "A2XD" ||
            LouvreType == "A2B"  || LouvreType == "A2X") && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.65 * 0.84, 2));
    action((LouvreType == "A2BD" || LouvreType == "A2XD" ||
            LouvreType == "A2B"  || LouvreType == "A2X") && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.65 * 0.75, 2));

    // ── A2I insulated aluminium louvre (Cv = 0.72) ──
    action(LouvreType == "A2I" && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.72, 2));
    action(LouvreType == "A2I" && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.72 * 0.95, 2));
    action(LouvreType == "A2I" && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.72 * 0.84, 2));
    action(LouvreType == "A2I" && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.72 * 0.75, 2));

    // ── PCR / POR 9mm polycarbonate louvres (Cv = 0.62) ──
    action((LouvreType == "PCR" || LouvreType == "POR") && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.62, 2));
    action((LouvreType == "PCR" || LouvreType == "POR") && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.62 * 0.95, 2));
    action((LouvreType == "PCR" || LouvreType == "POR") && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.62 * 0.84, 2));
    action((LouvreType == "PCR" || LouvreType == "POR") && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.62 * 0.75, 2));

    // ── PC16 / PO16 16mm polycarbonate louvres (Cv = 0.60) ──
    action((LouvreType == "PC16" || LouvreType == "PO16") && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60, 2));
    action((LouvreType == "PC16" || LouvreType == "PO16") && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.95, 2));
    action((LouvreType == "PC16" || LouvreType == "PO16") && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.84, 2));
    action((LouvreType == "PC16" || LouvreType == "PO16") && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.75, 2));

    // ── GWR wired glass louvre (Cv = 0.60) ──
    action(LouvreType == "GWR" && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60, 2));
    action(LouvreType == "GWR" && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.95, 2));
    action(LouvreType == "GWR" && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.84, 2));
    action(LouvreType == "GWR" && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60 * 0.75, 2));

    // ── GLR / GTR toughened glass louvres (Cv = 0.58) ──
    action((LouvreType == "GLR" || LouvreType == "GTR") && Guards == "X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.58, 2));
    action((LouvreType == "GLR" || LouvreType == "GTR") && Guards == "BG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.58 * 0.95, 2));
    action((LouvreType == "GLR" || LouvreType == "GTR") && Guards == "IS",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.58 * 0.84, 2));
    action((LouvreType == "GLR" || LouvreType == "GTR") && Guards == "IG",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.58 * 0.75, 2));


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 5 – RELEASE TEMPERATURE (°C)
    //  constraint(table(var, var, {...})) – valid CML
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ThermalRelease, ReleaseTemperature_int,
        {"FX",    0},
        {"FV68",  68}, {"FS68",  68}, {"FS68S",  68},
        {"F72",   68}, {"F72S",  68},
        {"1F72",  68}, {"1F72S", 68},
        {"2F72",  68}, {"2F72S", 68},
        {"FV93",  93}, {"FS93",  93}, {"FS93S",  93},
        {"F93",   93}, {"F93S",  93},
        {"1F93",  93}, {"1F93S", 93},
        {"2F93",  93}, {"2F93S", 93},
        {"FS141",  141}, {"FS141S", 141},
        {"F141",   141}, {"F141S",  141},
        {"1F141",  141}, {"1F141S", 141},
        {"2F141",  141}, {"2F141S", 141},
        {"FS182",  182}, {"FS182S", 182},
        {"F182",   182}, {"F182S",  182},
        {"1F182",  182}, {"1F182S", 182},
        {"2F182",  182}, {"2F182S", 182}),
        "ThermalRelease code to release temperature deg C");

    action(true, ReleaseTemperature = ReleaseTemperature_int);


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 6 – AMBIENT TEMPERATURE CLASS
    //  action(condition, variable = variable) – valid CML for var-to-var copy
    //
    //  [F2] NOTE: No .startsWith() used here – conditions are explicit values
    // ══════════════════════════════════════════════════════════════════════
    action(Control == "HE" || Control == "HI" || Control == "L",
           AmbientTempClass = "X");

    action(AmbientTemp == "X" &&
           Control != "HE" && Control != "HI" && Control != "L",
           AmbientTempClass = "X");

    // Pneumatic controls → all T classes certified
    action((Control == "P1O"   || Control == "P2O"   ||
            Control == "P1C"   || Control == "P2C"   ||
            Control == "P1O4"  || Control == "P2O4"  ||
            Control == "P1C4"  || Control == "P2C4"  ||
            Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           AmbientTemp != "X",
           AmbientTempClass = AmbientTemp);

    // Electric motor controls → T(-25) not certified
    action((Control == "M1B24"  || Control == "M2B24"  ||
            Control == "M1C24"  || Control == "M2C24"  ||
            Control == "M1O24"  || Control == "M2O24"  ||
            Control == "M1B24M" || Control == "M2B24M" ||
            Control == "M1C24J" || Control == "M2C24J" ||
            Control == "M1B24K" || Control == "M2B24K" ||
            Control == "M1B230" || Control == "M2B230" ||
            Control == "M1C230" || Control == "M2C230" ||
            Control == "M1O230" || Control == "M2O230" ||
            Control == "M1B230J"|| Control == "M2B230J"||
            Control == "M1C230J"|| Control == "M2C230J"||
            Control == "M1B24J" || Control == "M2B24J") &&
           (AmbientTemp == "T(00)" || AmbientTemp == "T(-05)" || AmbientTemp == "T(-15)"),
           AmbientTempClass = AmbientTemp);

    action((Control == "M1B24"  || Control == "M2B24"  ||
            Control == "M1C24"  || Control == "M2C24"  ||
            Control == "M1O24"  || Control == "M2O24"  ||
            Control == "M1B24M" || Control == "M2B24M" ||
            Control == "M1C24J" || Control == "M2C24J" ||
            Control == "M1B24K" || Control == "M2B24K" ||
            Control == "M1B230" || Control == "M2B230" ||
            Control == "M1C230" || Control == "M2C230" ||
            Control == "M1O230" || Control == "M2O230" ||
            Control == "M1B230J"|| Control == "M2B230J"||
            Control == "M1C230J"|| Control == "M2C230J"||
            Control == "M1B24J" || Control == "M2B24J") &&
           AmbientTemp == "T(-25)",
           AmbientTempClass = "X");

    message((Control == "M1B24"  || Control == "M2B24"  ||
             Control == "M1C24"  || Control == "M2C24"  ||
             Control == "M1O24"  || Control == "M2O24"  ||
             Control == "M1B24M" || Control == "M2B24M" ||
             Control == "M1B230" || Control == "M2B230" ||
             Control == "M1C230" || Control == "M2C230" ||
             Control == "M1O230" || Control == "M2O230") &&
            AmbientTemp == "T(-25)",
            "T(-25) is not certified for electric motor drives. T(-15) is the lowest certified class.",
            "Warning");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 7 – CO2 BOTTLE SIZE (g)
    //
    //  [F2] FIXED: Removed .startsWith("M"), .startsWith("FS"), etc.
    //       All control codes are listed explicitly.
    // ══════════════════════════════════════════════════════════════════════

    // Controls that never need CO2 (manual, single-acting pneumatic, electric)
    action(Control == "HE" || Control == "HI" || Control == "L" ||
           Control == "P1O"  || Control == "P2O"  ||
           Control == "P1C"  || Control == "P2C"  ||
           Control == "P1O4" || Control == "P2O4" ||
           Control == "P1C4" || Control == "P2C4" ||
           Control == "M1B24"  || Control == "M2B24"  ||
           Control == "M1C24"  || Control == "M2C24"  ||
           Control == "M1O24"  || Control == "M2O24"  ||
           Control == "M1B24M" || Control == "M2B24M" ||
           Control == "M1C24J" || Control == "M2C24J" ||
           Control == "M1B24K" || Control == "M2B24K" ||
           Control == "M1B230" || Control == "M2B230" ||
           Control == "M1C230" || Control == "M2C230" ||
           Control == "M1O230" || Control == "M2O230" ||
           Control == "M1B230J"|| Control == "M2B230J"||
           Control == "M1C230J"|| Control == "M2C230J"||
           Control == "M1B24J" || Control == "M2B24J",
           CO2Bottle = "X");

    // No thermal release (FX) or exhaust-valve (FV**) → no CO2 regardless
    action(ThermalRelease == "FX" ||
           ThermalRelease == "FV68" || ThermalRelease == "FV93",
           CO2Bottle = "X");

    // Locked/OS controls + fusible-link release (F**, 1F**, 2F**) → no CO2
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "F72"   || ThermalRelease == "F72S"  ||
            ThermalRelease == "F93"   || ThermalRelease == "F93S"  ||
            ThermalRelease == "F141"  || ThermalRelease == "F141S" ||
            ThermalRelease == "F182"  || ThermalRelease == "F182S" ||
            ThermalRelease == "1F72"  || ThermalRelease == "1F72S" ||
            ThermalRelease == "1F93"  || ThermalRelease == "1F93S" ||
            ThermalRelease == "1F141" || ThermalRelease == "1F141S"||
            ThermalRelease == "1F182" || ThermalRelease == "1F182S"||
            ThermalRelease == "2F72"  || ThermalRelease == "2F72S" ||
            ThermalRelease == "2F93"  || ThermalRelease == "2F93S" ||
            ThermalRelease == "2F141" || ThermalRelease == "2F141S"||
            ThermalRelease == "2F182" || ThermalRelease == "2F182S"),
           CO2Bottle = "X");

    // Locked/OS + FS68/FS93 TVV + small/medium unit → 20 g
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FS68"  || ThermalRelease == "FS68S" ||
            ThermalRelease == "FS93"  || ThermalRelease == "FS93S") &&
           ThroatWidth_mm < 1926 && ThroatLength_mm < 3099,
           CO2Bottle = "20");

    // Same controls + FS68/FS93 + large unit → 40 g
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FS68"  || ThermalRelease == "FS68S" ||
            ThermalRelease == "FS93"  || ThermalRelease == "FS93S") &&
           (ThroatWidth_mm >= 1926 || ThroatLength_mm >= 3099),
           CO2Bottle = "40");

    // FS141/FS182 TVV → corrected to 28 g (CO2-bottles!AF109 rule)
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FS141"  || ThermalRelease == "FS141S" ||
            ThermalRelease == "FS182"  || ThermalRelease == "FS182S"),
           CO2Bottle = "28");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 8 – OPENING PRESSURE (bar or "X")
    //  [F2] No .startsWith() – all motor codes listed explicitly
    // ══════════════════════════════════════════════════════════════════════
    action(Control == "HE" || Control == "HI" || Control == "L" ||
           Control == "P1O"  || Control == "P2O"  ||
           Control == "P1C"  || Control == "P2C"  ||
           Control == "P1O4" || Control == "P2O4" ||
           Control == "P1C4" || Control == "P2C4" ||
           Control == "M1B24"  || Control == "M2B24"  ||
           Control == "M1C24"  || Control == "M2C24"  ||
           Control == "M1O24"  || Control == "M2O24"  ||
           Control == "M1B24M" || Control == "M2B24M" ||
           Control == "M1C24J" || Control == "M2C24J" ||
           Control == "M1B24K" || Control == "M2B24K" ||
           Control == "M1B230" || Control == "M2B230" ||
           Control == "M1C230" || Control == "M2C230" ||
           Control == "M1O230" || Control == "M2O230" ||
           Control == "M1B230J"|| Control == "M2B230J"||
           Control == "M1C230J"|| Control == "M2C230J"||
           Control == "M1B24J" || Control == "M2B24J",
           OpeningPressureVent  = "X");

    action(Control == "HE" || Control == "HI" || Control == "L" ||
           Control == "P1O"  || Control == "P2O"  ||
           Control == "P1C"  || Control == "P2C"  ||
           Control == "P1O4" || Control == "P2O4" ||
           Control == "P1C4" || Control == "P2C4" ||
           Control == "M1B24"  || Control == "M2B24"  ||
           Control == "M1C24"  || Control == "M2C24"  ||
           Control == "M1O24"  || Control == "M2O24"  ||
           Control == "M1B24M" || Control == "M2B24M" ||
           Control == "M1C24J" || Control == "M2C24J" ||
           Control == "M1B24K" || Control == "M2B24K" ||
           Control == "M1B230" || Control == "M2B230" ||
           Control == "M1C230" || Control == "M2C230" ||
           Control == "M1O230" || Control == "M2O230" ||
           Control == "M1B230J"|| Control == "M2B230J"||
           Control == "M1C230J"|| Control == "M2C230J"||
           Control == "M1B24J" || Control == "M2B24J",
           OpeningPressureSmoke = "X");

    // Pressure-dependent locked/OS controls – ventilation pressure ≥ 2 bar
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP"),
           OpeningPressureVent = "2");

    // Smoke pressure – size-dependent bands
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           ThroatWidth_mm <= 1326 && ThroatLength_mm <= 2035,
           OpeningPressureSmoke = "2");

    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           ((ThroatWidth_mm >= 1476 && ThroatWidth_mm <= 1776) ||
            (ThroatLength_mm >= 2168 && ThroatLength_mm <= 2567)),
           OpeningPressureSmoke = "4.9");

    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThroatWidth_mm >= 1926 || ThroatLength_mm >= 2700),
           OpeningPressureSmoke = "9.8");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 9 – WIND LOAD CLASS
    //  action(condition, string_var = "literal") – valid CML
    // ══════════════════════════════════════════════════════════════════════
    action(LouvreType == "A1B" || LouvreType == "A1X" ||
           LouvreType == "A2BD"|| LouvreType == "A2XD"||
           LouvreType == "A2B" || LouvreType == "A2X" ||
           LouvreType == "A2I",
           WindLoad = "4000");

    action((LouvreType == "PCR" || LouvreType == "POR") &&
           ThroatWidth_mm <= 1776 && ThroatLength_mm <= 2700,
           WindLoad = "4000");

    action((LouvreType == "PCR" || LouvreType == "POR") &&
           (ThroatWidth_mm > 1776 || ThroatLength_mm > 2700),
           WindLoad = "3000");

    action(LouvreType == "PC16" || LouvreType == "PO16",
           WindLoad = "1500");

    action(LouvreType == "GWR" && ThroatWidth_mm <= 1326 && ThroatLength_mm <= 2168,
           WindLoad = "3000");

    action(LouvreType == "GWR" && (ThroatWidth_mm > 1326 || ThroatLength_mm > 2168),
           WindLoad = "1500");

    action(LouvreType == "GLR" || LouvreType == "GTR",
           WindLoad = "1500");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 10 – SNOW LOAD
    //  action(condition, string_var = "literal") – valid CML
    // ══════════════════════════════════════════════════════════════════════
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           Version != "2V" &&
           ThroatWidth_mm <= 1326 && ThroatLength_mm <= 2035,
           SnowLoad = "1618");

    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           Version != "2V" &&
           (ThroatWidth_mm > 1326 || ThroatLength_mm > 2035),
           SnowLoad = "1000");

    action((Control == "P1O"  || Control == "P2O"  ||
            Control == "P1C"  || Control == "P2C"  ||
            Control == "P1O4" || Control == "P2O4" ||
            Control == "P1C4" || Control == "P2C4") &&
           Version != "2V",
           SnowLoad = "500");

    action((Control == "M1B24"  || Control == "M2B24"  ||
            Control == "M1C24"  || Control == "M2C24"  ||
            Control == "M1O24"  || Control == "M2O24"  ||
            Control == "M1B24M" || Control == "M2B24M" ||
            Control == "M1C24J" || Control == "M2C24J" ||
            Control == "M1B24K" || Control == "M2B24K" ||
            Control == "M1B230" || Control == "M2B230" ||
            Control == "M1C230" || Control == "M2C230" ||
            Control == "M1O230" || Control == "M2O230" ||
            Control == "M1B230J"|| Control == "M2B230J"||
            Control == "M1C230J"|| Control == "M2C230J"||
            Control == "M1B24J" || Control == "M2B24J") &&
           Version != "2V",
           SnowLoad = "250");

    action((Control == "HE" || Control == "HI" || Control == "L") && Version != "2V",
           SnowLoad = "250");

    action(Version == "2V",
           SnowLoad = "1500");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 11 – U-VALUE
    //
    //  [F8] FIXED: v1.0 used constraint((condition) -> table(...)) which
    //       mixed implication and table constraint.
    //       FIX: action rule handles CB* → "X"; standalone constraint(table)
    //       handles STD/UB* – the table constraint is bidirectional so it will
    //       only apply to valid [LouvreType, Insulation] combinations for
    //       those base types.  The two rules are logically non-overlapping
    //       because the action rule fires when BaseType is CB* and the table
    //       constraint fires when BaseType is not CB*.
    //       NOTE: For UValue as a 3-column table, the implication guard can
    //       be added using a standard constraint implication if needed:
    //       constraint(BaseType != "CB2" && BaseType != "CB3" && BaseType != "CB4"
    //                  -> table(LouvreType, Insulation, UValue, {...}), "msg")
    //       This IS valid CML (implication wrapping a table constraint).
    // ══════════════════════════════════════════════════════════════════════
    action(BaseType == "CB2" || BaseType == "CB3" || BaseType == "CB4",
           UValue = "X");

    // Conditional table: applies only when BaseType is NOT a conical base
    constraint(
        BaseType != "CB2" && BaseType != "CB3" && BaseType != "CB4" ->
        table(LouvreType, Insulation, UValue,
            {"A1B",  "X", "5.51"}, {"A1X",  "X", "5.51"},
            {"A2BD", "X", "4.62"}, {"A2XD", "X", "4.62"},
            {"A2B",  "X", "4.62"}, {"A2X",  "X", "4.62"},
            {"A2I",  "X", "1.87"},
            {"PCR",  "X", "5.72"}, {"POR",  "X", "5.72"},
            {"PC16", "X", "3.43"}, {"PO16", "X", "3.43"},
            {"GWR",  "X", "4.18"},
            {"GLR",  "X", "3.86"}, {"GTR",  "X", "3.86"},
            {"A1B",  "I", "2.43"}, {"A1X",  "I", "2.43"},
            {"A2BD", "I", "2.30"}, {"A2XD", "I", "2.30"},
            {"A2B",  "I", "2.30"}, {"A2X",  "I", "2.30"},
            {"A2I",  "I", "1.41"},
            {"PCR",  "I", "2.48"}, {"POR",  "I", "2.48"},
            {"PC16", "I", "1.98"}, {"PO16", "I", "1.98"},
            {"GWR",  "I", "2.17"},
            {"GLR",  "I", "2.10"}, {"GTR",  "I", "2.10"}),
        "U-value from louvre type and insulation (STD and UB bases only)");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 12 – WEIGHT
    //  [F9] message condition simplified – Weight is always "X" (sentinel)
    // ══════════════════════════════════════════════════════════════════════
    action(true, Weight = "X");

    message(true,
            "Weight is from the factory table (weight!C352). Implement via Apex invocable action.",
            "Info");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 13 – CONFIGURATION BUSINESS RULES
    //
    //  [F4] FIXED: require() only accepts relation[Type] as second arg.
    //       Attribute-to-attribute constraints use constraint(A -> B, "msg").
    //
    //  [F5] FIXED: exclude() only accepts relation[Type] as second arg.
    //       Attribute value exclusions use constraint(cond -> !, "msg").
    //
    //  [F6] FIXED: Unicode → replaced with ASCII ->
    //  [F3] FIXED: & concatenation removed; messages are single string literals
    // ══════════════════════════════════════════════════════════════════════

    // ── Version restrictions ───────────────────────────────────────────
    // [F5] Was: exclude(Version != "3S", Guards == "IG" || ...)
    constraint(Version != "3S" ->
               Guards != "IG" && Guards != "IS" && Guards != "BG",
               "External guards (IG/IS/BG) are only available with version 3S.");

    constraint(Version != "3S" ->
               BurglarGuards != "S",
               "Burglar guard (S) is only available with version 3S.");

    constraint(Version != "3S" ->
               BaseType != "CB3" && BaseType != "CB4",
               "CB3 and CB4 base types are only available with version 3S.");

    // ── Wall installation ──────────────────────────────────────────────
    // [F5] Was: exclude(AssemblySituation == "W", UpstandDesign != "X")
    constraint(AssemblySituation == "W" -> UpstandDesign == "X",
               "Upstand is not used for wall installation. Select Without upstand.");

    constraint(Version == "2V" -> AssemblySituation != "W",
               "Version 2V (VdS) is not certified for wall installation.");

    // ── CB* base restrictions ──────────────────────────────────────────
    // [F5] Was: exclude(BaseType == "CB*", InsulatedAdapter == "A")
    constraint((BaseType == "CB2" || BaseType == "CB3" || BaseType == "CB4") ->
               InsulatedAdapter != "A",
               "Insulated adapter is not available with conical (CB2/CB3/CB4) base types.");

    // ── Louvre-specific restrictions ───────────────────────────────────
    // [F5] Was: exclude(LouvreType == "PC16" || LouvreType == "PO16", RemovableLouvre == "R")
    constraint((LouvreType == "PC16" || LouvreType == "PO16") ->
               RemovableLouvre != "R",
               "Externally removable louvre is not available with PC16 or PO16 louvre type.");

    // ── Finish / Coverage dependency ───────────────────────────────────
    // [F5] Was: exclude(Finish == "X", Coverage != "X") -- invalid exclude on attr
    constraint(Finish == "X" -> Coverage == "X",
               "Paint coverage can only be specified when a paint finish is selected.");

    // [F4] Was: require(Coverage != "X", Finish != "X", ...) -- invalid require on attr
    constraint(Coverage != "X" -> Finish != "X",
               "A paint finish must be selected when specifying coverage.");

    // RAL colour warning
    message(Finish != "X" && RALColour == "",
            "Please specify a RAL colour number for the selected paint finish.",
            "Warning");

    // ── Informational messages ─────────────────────────────────────────
    // [F3] Was: message with & string concatenation → single string literal
    message(BaseType == "CB2" || BaseType == "CB3" || BaseType == "CB4",
            "U-value is not certified for conical upstand base types. U-value field shows X.",
            "Info");

    message(AerodynamicAreaAa < 0.50,
            "Aerodynamic area Aa is below 0.50 m2. Please verify this unit meets smoke exhaust requirements.",
            "Warning");

    message(ThroatWidth_mm >= 2000 || ThroatLength_mm >= 3000,
            "Large-format unit selected. Please confirm structural suitability and contact the factory.",
            "Info");

    message(LiftingEyes == "Yes",
            "Factory-fitted lifting eyes add approximately 2 to 4 kg and require pre-order confirmation.",
            "Info");

    // [F3] Was: two string literals joined with & → single literal
    message(InsulatedAdapter == "A" && Insulation == "X",
            "Insulated adapter (A) is selected without body insulation (I). Confirm this is intentional.",
            "Warning");

}   // end type CO
