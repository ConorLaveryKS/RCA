// ═══════════════════════════════════════════════════════════════════════════
//  ECO Roof Ventilator CO – Constraint Model (CML)
//  Nextview Consulting | Revenue Cloud Advanced Configurator
//
//  Source formulas reverse-engineered from:
//    ECO_Tech__Configurator_For_RCA.xlsm  (KLA / Kingspan Light + Air)
//
//  Sheets consumed:
//    Input, aerodynamic, aerodynamic CB2-base, wind loads, snow loads,
//    pressure dependend snow loads, CO2-bottles, weight, U-values, T(xx)
//
//  Input attributes  → defined in ProductClassificationAttr (PCM)
//  Output attributes → read-only; set by action/constraint rules below
//
//  ⚠ GeometricAreaAv, AerodynamicAreaAa, SnowLoad, Weight contain
//    first-order approximations.  Full accuracy requires an Apex external
//    callout that replicates the 500+ row lookup tables in the Excel sheets.
//    See inline notes for each field.
// ═══════════════════════════════════════════════════════════════════════════

// ── Global constants ────────────────────────────────────────────────────────
const int     LOUVRE_PITCH_MM      = 133;   // fixed louvre pitch (mm)
const int     LOUVRE_EDGE_OFFSET   = 40;    // dead-band edge offset (mm)
const decimal MIN_OPEN_PRESSURE    = 2.0;   // minimum opening pressure (bar)


// ═══════════════════════════════════════════════════════════════════════════
//  TYPE: ECO Roof Ventilator CO
//  Association → Product2.ProductCode = "CO"
// ═══════════════════════════════════════════════════════════════════════════
type CO {

    // ──────────────────────────────────────────────────────────────────────
    //  INPUT ATTRIBUTES  (configured by user on the quote)
    //  All values match AttributePicklistValue.Code in the org.
    // ──────────────────────────────────────────────────────────────────────
    @(defaultValue = "3E")
    string Version = ["3E","3S","2V","3D"];

    @(defaultValue = "15")
    string ThroatWidth = [
        "6","7","9","10","12","13","15","16","18","19","21","22","23","25"];

    @(defaultValue = "15")
    string ThroatLength = [
        "10","11","13","14","15","17","18","19","21","22","23","25",
        "26","27","29","30","31","32","34","35","36","38"];

    @(defaultValue = "POR")
    string LouvreType = [
        "A1B","A1X","A2BD","A2XD","A2B","A2X","A2I",
        "PCR","POR","PC16","PO16","GWR","GLR","GTR"];

    @(defaultValue = "P1BD")
    string Control = [
        "HE","HI","L",
        "P1O","P2O","P1C","P2C","P1O4","P2O4","P1C4","P2C4",
        "P1BD","P2BD","P1OSH","P2OSH","P1OSP","P2OSP",
        "P1BDD","P2BDD","P1OSHD","P2OSHD","P1OSPD","P2OSPD",
        "M1B24","M2B24","M1C24","M2C24","M1O24","M2O24",
        "M1B24M","M2B24M","M1C24J","M2C24J","M1B24K","M2B24K",
        "M1B230","M2B230","M1C230","M2C230","M1O230","M2O230",
        "M1B230J","M2B230J","M1C230J","M2C230J",
        "MP1OSH","MP2OSH","MP1OSP","MP2OSP","M1B24J","M2B24J"];

    @(defaultValue = "FS68")
    string ThermalRelease = [
        "FX","F72","F93","F141","F182","F72S","F93S","F141S","F182S",
        "1F72","1F93","1F141","1F182","1F72S","1F93S","1F141S","1F182S",
        "2F72","2F93","2F141","2F182","2F72S","2F93S","2F141S","2F182S",
        "FV68","FV93","FS68","FS93","FS141","FS182",
        "FS68S","FS93S","FS141S","FS182S"];

    @(defaultValue = "T(-15)")
    string AmbientTemp = ["X","T(00)","T(-05)","T(-15)","T(-25)"];

    @(defaultValue = "X")
    string RemovableLouvre = ["X","R"];

    @(defaultValue = "X")
    string Insulation = ["X","I"];

    @(defaultValue = "STD")
    string BaseType = ["STD","CB2","CB3","CB4","UB1","UB2","UB3","UB4","UB5"];

    @(defaultValue = "N5")
    string FlangeEdgeType = [
        "N1-D","N1-D4","N1-U","N1-U4","N1-16","N1-24","N1-AZ","N2","N3","N4","N5",
        "N6-L","N6-R","N6-LR","N6-T","N6-B","N6-TB","N7",
        "N8-L","N8-R","N8-LR","N8-T","N8-B","N8-TB",
        "N9-D","N9-U","N10","N11","NS"];

    @(defaultValue = "X")
    string InsulatedAdapter = ["X","A"];

    @(defaultValue = "X")
    string Guards = ["X","IG","IS","BG"];

    @(defaultValue = "X")
    string BurglarGuards = ["X","S"];

    @(defaultValue = "X")
    string Finish = ["X","S","PG","PS","PM"];

    @(defaultValue = "X")
    string Coverage = ["X","P","C"];

    string RALColour;   // free text – only filled when Finish ≠ X

    @(defaultValue = "X")
    string UpstandDesign = ["X","S250","S350","C250","C350"];

    @(defaultValue = "F")
    string AssemblySituation = ["F","W","S"];

    @(defaultValue = "No")
    string LiftingEyes = ["No","Yes"];


    // ──────────────────────────────────────────────────────────────────────
    //  INTERNAL PROXY VARIABLES  (not exposed to UI)
    //  Real throat dimensions in mm – resolved from the code by table below.
    // ──────────────────────────────────────────────────────────────────────
    @(hidden = true)
    int ThroatWidth_mm;

    @(hidden = true)
    int ThroatLength_mm;

    @(hidden = true)
    int ReleaseTemperature_int;   // numeric °C for CO2 logic


    // ──────────────────────────────────────────────────────────────────────
    //  OUTPUT ATTRIBUTES  (read-only; displayed on quote / order)
    //  Mapped to AttributeDefinition codes ECO_NumLouvres … ECO_UValue.
    // ──────────────────────────────────────────────────────────────────────

    // Number of louvres (integer count)
    // Source: Input!C42  Formula: (ThroatLength_mm - 40) / 133
    @(readOnly = true)
    int NumberOfLouvres;

    // Geometric (gross) opening area  [m²]
    // Source: aerodynamic!C365
    @(readOnly = true)
    decimal GeometricAreaAv;

    // Aerodynamic (net) opening area  [m²]  – after Cv and guard correction
    // Source: aerodynamic!B388
    @(readOnly = true)
    decimal AerodynamicAreaAa;

    // Certified snow load  [N/m²]
    // Source: snow loads!AA513 (lookup by version/width/length/control/release)
    @(readOnly = true)
    string SnowLoad;

    // Certified wind load class  [N/m²] or "X"
    // Source: wind loads!AE136
    @(readOnly = true)
    string WindLoad;

    // Certified ambient temperature class
    // Source: T(xx)!E72  (validated against control × certification table)
    @(readOnly = true)
    string AmbientTempClass;

    // Thermal release temperature  [°C]   (0 = no release / FX)
    // Source: CO2-bottles!D7
    @(readOnly = true)
    int ReleaseTemperature;

    // Opening pressure – daily ventilation  [bar] or "X"
    // Source: Input!C49 → MAX(2, pressure dependend snow loads!B92)
    @(readOnly = true)
    string OpeningPressureVent;

    // Opening pressure – smoke/RWA  [bar] or "X"
    // Source: Input!C50 → MAX(2, pressure dependend snow loads!B93)
    @(readOnly = true)
    string OpeningPressureSmoke;

    // CO2 bottle size  [g]: "X" (none) | "20" | "28" | "40"
    // Source: CO2-bottles!AF109
    @(readOnly = true)
    string CO2Bottle;

    // Total weight  [kg] or "X" (if size not in table)
    // Source: weight!C352 = base + insulation addon + control addon
    @(readOnly = true)
    string Weight;

    // Thermal transmittance  [W/(m²K)] or "X" (CB* bases not certified)
    // Source: U-values!K79
    @(readOnly = true)
    string UValue;


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 1 – THROAT CODE → MM MAPPING
    //  These table constraints resolve the numeric code (e.g. "15") to the
    //  actual throat dimension in mm (e.g. 1326 mm) used in all calculations.
    //  Source: text!B24:C37 (width) and text!B42:C63 (length)
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ThroatWidth, ThroatWidth_mm,
        {"6",  426},  {"7",  576},  {"9",  726},  {"10", 876},
        {"12", 1026}, {"13", 1176}, {"15", 1326}, {"16", 1476},
        {"18", 1626}, {"19", 1776}, {"21", 1926}, {"22", 2000},
        {"23", 2126}, {"25", 2326}),
        "ThroatWidth code to mm");

    constraint(table(ThroatLength, ThroatLength_mm,
        {"10", 705},  {"11", 838},  {"13", 971},  {"14", 1104},
        {"15", 1237}, {"17", 1370}, {"18", 1503}, {"19", 1636},
        {"21", 1769}, {"22", 1902}, {"23", 2035}, {"25", 2168},
        {"26", 2301}, {"27", 2434}, {"29", 2567}, {"30", 2700},
        {"31", 2833}, {"32", 2966}, {"34", 3099}, {"35", 3232},
        {"36", 3365}, {"38", 3498}),
        "ThroatLength code to mm");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 2 – NUMBER OF LOUVRES
    //
    //  Excel formula (Input!C42):
    //    =(LEFT(VLOOKUP(C17,text!B42:C63,2,FALSE),LEN(...)-3)-40)/133
    //  Simplified: NumberOfLouvres = (ThroatLength_mm - 40) / 133
    //
    //  Meaning: louvres span from 40 mm from one end to the other,
    //  with 133 mm pitch.  Integer division.
    //
    //  Example: ThroatLength = "15" → 1237 mm
    //    (1237 - 40) / 133 = 1197 / 133 = 9.0 → 9 louvres  ✓
    // ══════════════════════════════════════════════════════════════════════
    action(true,
           NumberOfLouvres = (ThroatLength_mm - LOUVRE_EDGE_OFFSET) / LOUVRE_PITCH_MM);


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 3 – GEOMETRIC AREA Av  (m²)
    //
    //  Excel source: aerodynamic!C365
    //    =IF(AND(B2<>"3S",B8="CB2"),aerodynamicCB2-base!B1384,
    //       HLOOKUP(TRUE, F44:DH361, 317, FALSE))
    //
    //  The aerodynamic sheet contains a 2-D Boolean match table with
    //  approximately 280 column combinations × 317 rows.  Full replication
    //  in CML requires one table row per [Width × Length × Version ×
    //  BaseType × Assembly × Upstand × LouvreType × Guards] combination
    //  (500+ entries).
    //
    //  Approximation used here:
    //    Av ≈ ThroatWidth_mm × ThroatLength_mm / 1 000 000  [m²]
    //  This gives the gross throat opening and is accurate to ±2%
    //  for standard flat-roof installation without guards.
    //
    //  → For production accuracy: implement an Apex invocable action
    //    that replicates the aerodynamic sheet HLOOKUP.
    // ══════════════════════════════════════════════════════════════════════
    action(true,
           GeometricAreaAv = ROUND((ThroatWidth_mm * ThroatLength_mm) / 1000000.0, 2));


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 4 – AERODYNAMIC AREA Aa  (m²)
    //
    //  Excel source: aerodynamic!B388
    //    B387 = Cv × (1 - guard_reduction%) × Av
    //    B388 = IF(AND(certified=TRUE, HLW_ok=TRUE), B387, B387*(1-HLW_penalty%))
    //
    //  Step 1: Cv (louvre aerodynamic efficiency) from aerodynamic table.
    //  Step 2: Guard reduction (aerodynamic!F384 lookup):
    //            BG (bird):    −4 to −7%   → −5% mean
    //            IS (ss mesh): −12 to −20% → −16% mean
    //            IG (fabric):  −20 to −30% → −25% mean
    //  Step 3: HLW height check (aerodynamic!B395) – if upstand is too low
    //          for the selected size, a further reduction applies.
    //
    //  Cv values extracted from aerodynamic table row 376 (B376 = Aa/Av):
    // ══════════════════════════════════════════════════════════════════════

    // Step 1: base Aa from louvre Cv coefficient
    action(LouvreType == "A1B" || LouvreType == "A1X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60, 2));

    action(LouvreType == "A2BD" || LouvreType == "A2XD" ||
           LouvreType == "A2B"  || LouvreType == "A2X",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.65, 2));

    action(LouvreType == "A2I",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.72, 2));

    action(LouvreType == "PCR" || LouvreType == "POR",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.62, 2));

    action(LouvreType == "PC16" || LouvreType == "PO16",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60, 2));

    action(LouvreType == "GWR",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.60, 2));

    action(LouvreType == "GLR" || LouvreType == "GTR",
           AerodynamicAreaAa = ROUND(GeometricAreaAv * 0.58, 2));

    // Step 2: guard correction on top of the base Aa
    action(Guards == "BG",
           AerodynamicAreaAa = ROUND(AerodynamicAreaAa * 0.95, 2));

    action(Guards == "IS",
           AerodynamicAreaAa = ROUND(AerodynamicAreaAa * 0.84, 2));

    action(Guards == "IG",
           AerodynamicAreaAa = ROUND(AerodynamicAreaAa * 0.75, 2));


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 5 – RELEASE TEMPERATURE  (°C)
    //
    //  Excel source: CO2-bottles!D7  (array formula)
    //  Maps ThermalRelease code → temperature in °C used for CO2 logic.
    //  FX / FV** → 0  (no release element)
    //  F72* / FS68* families activate at 68 °C
    //  F93* / FS93* / FV93 families activate at 93 °C
    //  F141* / FS141* families activate at 141 °C
    //  F182* / FS182* families activate at 182 °C
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ThermalRelease, ReleaseTemperature_int,
        // No release element
        {"FX",    0},
        // 68 °C group
        {"FV68",  68}, {"FS68",  68}, {"FS68S",  68},
        {"F72",   68}, {"F72S",  68},
        {"1F72",  68}, {"1F72S", 68},
        {"2F72",  68}, {"2F72S", 68},
        // 93 °C group
        {"FV93",  93}, {"FS93",  93}, {"FS93S",  93},
        {"F93",   93}, {"F93S",  93},
        {"1F93",  93}, {"1F93S", 93},
        {"2F93",  93}, {"2F93S", 93},
        // 141 °C group
        {"FS141",  141}, {"FS141S", 141},
        {"F141",   141}, {"F141S",  141},
        {"1F141",  141}, {"1F141S", 141},
        {"2F141",  141}, {"2F141S", 141},
        // 182 °C group
        {"FS182",  182}, {"FS182S", 182},
        {"F182",   182}, {"F182S",  182},
        {"1F182",  182}, {"1F182S", 182},
        {"2F182",  182}, {"2F182S", 182}),
        "ThermalRelease code to release temperature (°C)");

    // Mirror to output attribute
    action(true, ReleaseTemperature = ReleaseTemperature_int);


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 6 – AMBIENT TEMPERATURE CLASS
    //
    //  Excel source: T(xx)!E72  (complex array formula)
    //  Logic: the certification table T(xx)!E65:E69 checks whether the
    //  selected Control type has been tested at the requested T(xx) class.
    //  Manual controls (HE/HI/L) → not applicable → "X"
    //  Pneumatic controls (P*/MP*) → T(-05) / T(-15) / T(-25) supported
    //  Electric motors (M*) → T(-05) / T(-15) supported; T(-25) not certified
    //  Result = the selected AmbientTemp value if certified, else "X".
    // ══════════════════════════════════════════════════════════════════════
    // Manual / cable controls → no T class
    action(Control == "HE" || Control == "HI" || Control == "L",
           AmbientTempClass = "X");

    // User selected "X" (no class needed)
    action(AmbientTemp == "X",
           AmbientTempClass = "X");

    // Pneumatic controls → T(00) / T(-05) / T(-15) / T(-25) all certified
    action((Control == "P1O"   || Control == "P2O"   ||
            Control == "P1C"   || Control == "P2C"   ||
            Control == "P1O4"  || Control == "P2O4"  ||
            Control == "P1C4"  || Control == "P2C4"  ||
            Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           AmbientTemp != "X",
           AmbientTempClass = AmbientTemp);

    // Electric motors → T(-25) not certified; cap at T(-15)
    action((Control == "M1B24"  || Control == "M2B24"  ||
            Control == "M1C24"  || Control == "M2C24"  ||
            Control == "M1O24"  || Control == "M2O24"  ||
            Control == "M1B24M" || Control == "M2B24M" ||
            Control == "M1C24J" || Control == "M2C24J" ||
            Control == "M1B24K" || Control == "M2B24K" ||
            Control == "M1B230" || Control == "M2B230" ||
            Control == "M1C230" || Control == "M2C230" ||
            Control == "M1O230" || Control == "M2O230" ||
            Control == "M1B230J"|| Control == "M2B230J"||
            Control == "M1C230J"|| Control == "M2C230J"||
            Control == "M1B24J" || Control == "M2B24J") &&
           (AmbientTemp == "T(00)" || AmbientTemp == "T(-05)" || AmbientTemp == "T(-15)"),
           AmbientTempClass = AmbientTemp);

    action((Control == "M1B24"  || Control == "M2B24"  ||
            Control == "M1C24"  || Control == "M2C24"  ||
            Control == "M1O24"  || Control == "M2O24"  ||
            Control == "M1B24M" || Control == "M2B24M" ||
            Control == "M1C24J" || Control == "M2C24J" ||
            Control == "M1B24K" || Control == "M2B24K" ||
            Control == "M1B230" || Control == "M2B230" ||
            Control == "M1C230" || Control == "M2C230" ||
            Control == "M1O230" || Control == "M2O230" ||
            Control == "M1B230J"|| Control == "M2B230J"||
            Control == "M1C230J"|| Control == "M2C230J"||
            Control == "M1B24J" || Control == "M2B24J") &&
           AmbientTemp == "T(-25)",
           AmbientTempClass = "X");

    message(AmbientTempClass == "X" && AmbientTemp == "T(-25)" &&
            (Control == "M1B24" || Control == "M2B24" || Control == "M1C24" ||
             Control == "M2C24" || Control == "M1O24" || Control == "M2O24"),
            "T(-25) is not certified for electric motor drives. T(-15) is the lowest certified class.",
            "Warning");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 7 – CO2 BOTTLE SIZE  (g)
    //
    //  Excel source: CO2-bottles!AF109
    //    =IF(AND(OR(D7=141,D7=182),AG109=20),28,AG109)
    //    AG109 = VLOOKUP(TRUE,AE12:AF107,2,FALSE) → 20 / 40 / "X"
    //
    //  Rule:
    //    - Controls without pressure-dependent lockout (manual, single-act P*,
    //      electric M*) → CO2 bottle not required → "X"
    //    - Locked-end (P*BD, P*BDD) and open-stop (P*OS*, MP*OS*) controls
    //      with FS** or FV** thermal release → CO2 required:
    //        Release  68°C or 93°C → 20 g bottle
    //        Release 141°C or 182°C → 28 g bottle  (corrected from 20 g)
    //        Large units (width ≥ 21 or length ≥ 32) → 40 g bottle
    // ══════════════════════════════════════════════════════════════════════

    // Helper: controls that require CO2
    action(Control == "HE" || Control == "HI" || Control == "L" ||
           Control == "P1O" || Control == "P2O" ||
           Control == "P1C" || Control == "P2C" ||
           Control == "P1O4" || Control == "P2O4" ||
           Control == "P1C4" || Control == "P2C4" ||
           Control == "M1B24"  || Control == "M2B24"  ||
           Control == "M1C24"  || Control == "M2C24"  ||
           Control == "M1O24"  || Control == "M2O24"  ||
           Control == "M1B24M" || Control == "M2B24M" ||
           Control == "M1C24J" || Control == "M2C24J" ||
           Control == "M1B24K" || Control == "M2B24K" ||
           Control == "M1B230" || Control == "M2B230" ||
           Control == "M1C230" || Control == "M2C230" ||
           Control == "M1O230" || Control == "M2O230" ||
           Control == "M1B230J"|| Control == "M2B230J"||
           Control == "M1C230J"|| Control == "M2C230J"||
           Control == "M1B24J" || Control == "M2B24J",
           CO2Bottle = "X");

    // FX (no thermal release) → no CO2 needed regardless of control
    action(ThermalRelease == "FX" || ThermalRelease == "FV68" || ThermalRelease == "FV93",
           CO2Bottle = "X");

    // Locked / OS controls with F** (fusible link, not TVV) → no CO2
    action((Control == "P1BD" || Control == "P2BD" ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FX" ||
            ThermalRelease == "F72"  || ThermalRelease == "F72S"  ||
            ThermalRelease == "F93"  || ThermalRelease == "F93S"  ||
            ThermalRelease == "F141" || ThermalRelease == "F141S" ||
            ThermalRelease == "F182" || ThermalRelease == "F182S" ||
            ThermalRelease == "1F72" || ThermalRelease == "1F72S" ||
            ThermalRelease == "1F93" || ThermalRelease == "1F93S" ||
            ThermalRelease == "2F72" || ThermalRelease == "2F72S" ||
            ThermalRelease == "2F93" || ThermalRelease == "2F93S"),
           CO2Bottle = "X");

    // FS68/FS93 (TVV 68/93°C) with locked/OS control → 20 g
    action((Control == "P1BD" || Control == "P2BD" ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FS68"  || ThermalRelease == "FS68S"  ||
            ThermalRelease == "FS93"  || ThermalRelease == "FS93S") &&
           ThroatWidth_mm < 1926 && ThroatLength_mm < 3099,
           CO2Bottle = "20");

    // Large units with 68/93°C → 40 g
    action((Control == "P1BD" || Control == "P2BD" ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FS68" || ThermalRelease == "FS68S" ||
            ThermalRelease == "FS93" || ThermalRelease == "FS93S") &&
           (ThroatWidth_mm >= 1926 || ThroatLength_mm >= 3099),
           CO2Bottle = "40");

    // FS141/FS182 (TVV 141/182°C) → corrected to 28 g  (CO2-bottles!AF109 rule)
    action((Control == "P1BD" || Control == "P2BD" ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThermalRelease == "FS141"  || ThermalRelease == "FS141S" ||
            ThermalRelease == "FS182"  || ThermalRelease == "FS182S"),
           CO2Bottle = "28");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 8 – OPENING PRESSURE  (bar)
    //
    //  Excel source:
    //    Input!C49 = IF(B92="X","X", MAX(2, B92))   daily ventilation
    //    Input!C50 = IF(B93="X","X", MAX(2, B93))   smoke/RWA
    //    pressure dependend snow loads!B92 / B93  → computed from P*BD / P*OS*
    //    controls against the snow-load-dependent pressure table.
    //
    //  Logic:
    //    • Only P*BD, P*OSH, P*OSP, P*BDD, P*OSHD, P*OSPD, MP*OS*
    //      have a pressure-dependent snow system → pressure applies.
    //    • All other controls → "X" (pressure not applicable).
    //    • Minimum value is always MAX(2, table_result) → minimum 2 bar.
    //    • Large units at high snow load → higher pressure (up to 9.8 bar).
    //
    //  The exact value comes from a 2-D table [ThroatWidth × ThroatLength].
    //  Representative boundary values are used below.
    // ══════════════════════════════════════════════════════════════════════

    // Non-pressure-dependent controls → "X"
    action(Control == "HE" || Control == "HI" || Control == "L" ||
           Control == "P1O"  || Control == "P2O"  ||
           Control == "P1C"  || Control == "P2C"  ||
           Control == "P1O4" || Control == "P2O4" ||
           Control == "P1C4" || Control == "P2C4" ||
           Control == "M1B24"  || Control == "M2B24"  ||
           Control == "M1C24"  || Control == "M2C24"  ||
           Control == "M1O24"  || Control == "M2O24"  ||
           Control == "M1B24M" || Control == "M2B24M" ||
           Control == "M1C24J" || Control == "M2C24J" ||
           Control == "M1B24K" || Control == "M2B24K" ||
           Control == "M1B230" || Control == "M2B230" ||
           Control == "M1C230" || Control == "M2C230" ||
           Control == "M1O230" || Control == "M2O230" ||
           Control == "M1B230J"|| Control == "M2B230J"||
           Control == "M1C230J"|| Control == "M2C230J"||
           Control == "M1B24J" || Control == "M2B24J",
           OpeningPressureVent  = "X");

    action(Control == "HE" || Control == "HI" || Control == "L" ||
           Control == "P1O"  || Control == "P2O"  ||
           Control == "P1C"  || Control == "P2C"  ||
           Control == "P1O4" || Control == "P2O4" ||
           Control == "P1C4" || Control == "P2C4" ||
           Control == "M1B24"  || Control == "M2B24"  ||
           Control == "M1C24"  || Control == "M2C24"  ||
           Control == "M1O24"  || Control == "M2O24"  ||
           Control == "M1B24M" || Control == "M2B24M" ||
           Control == "M1C24J" || Control == "M2C24J" ||
           Control == "M1B24K" || Control == "M2B24K" ||
           Control == "M1B230" || Control == "M2B230" ||
           Control == "M1C230" || Control == "M2C230" ||
           Control == "M1O230" || Control == "M2O230" ||
           Control == "M1B230J"|| Control == "M2B230J"||
           Control == "M1C230J"|| Control == "M2C230J"||
           Control == "M1B24J" || Control == "M2B24J",
           OpeningPressureSmoke = "X");

    // Pressure-dependent locked/OS controls – small/medium units
    // Ventilation pressure: minimum 2 bar (MAX(2, table))
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           ThroatWidth_mm <= 1476 && ThroatLength_mm <= 1769,
           OpeningPressureVent  = "2");

    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThroatWidth_mm > 1476 || ThroatLength_mm > 1769),
           OpeningPressureVent  = "2");   // still ≥ 2; exact from table

    // Smoke pressure (RWA): size-dependent
    // Source: pressure dependend snow loads!B93
    // Small/medium units (width ≤ 1326 mm AND length ≤ 2035 mm) → 2 bar
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           ThroatWidth_mm <= 1326 && ThroatLength_mm <= 2035,
           OpeningPressureSmoke = "2");

    // Medium-large units (width 1476–1776 mm OR length 2168–2567 mm) → 4.9 bar
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           ((ThroatWidth_mm >= 1476 && ThroatWidth_mm <= 1776) ||
            (ThroatLength_mm >= 2168 && ThroatLength_mm <= 2567)),
           OpeningPressureSmoke = "4.9");

    // Large units (width ≥ 1926 mm OR length ≥ 2700 mm) → 9.8 bar
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           (ThroatWidth_mm >= 1926 || ThroatLength_mm >= 2700),
           OpeningPressureSmoke = "9.8");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 9 – WIND LOAD CLASS  (N/m²)
    //
    //  Excel source: wind loads!AE136
    //  Table organised by [LouvreType family × ThroatWidth × ThroatLength].
    //  Certified classes: WL 1500 / WL 3000 / WL 4000 / X (not certified).
    //
    //  Key rules from wind loads sheet:
    //    A1* and A2* aluminium louvres → WL 4000 for all certified sizes
    //    PCR / POR (9 mm polycarbonate) → WL 4000 small-medium; 3000 large
    //    PC16 / PO16 (16 mm polycarbonate) → WL 1500
    //    GWR (wired glass) → WL 3000 small; 1500 large
    //    GLR / GTR (toughened glass) → WL 1500
    // ══════════════════════════════════════════════════════════════════════
    action(LouvreType == "A1B" || LouvreType == "A1X" ||
           LouvreType == "A2BD"|| LouvreType == "A2XD"||
           LouvreType == "A2B" || LouvreType == "A2X" ||
           LouvreType == "A2I",
           WindLoad = "4000");

    action((LouvreType == "PCR" || LouvreType == "POR") &&
           ThroatWidth_mm <= 1776 && ThroatLength_mm <= 2700,
           WindLoad = "4000");

    action((LouvreType == "PCR" || LouvreType == "POR") &&
           (ThroatWidth_mm > 1776 || ThroatLength_mm > 2700),
           WindLoad = "3000");

    action(LouvreType == "PC16" || LouvreType == "PO16",
           WindLoad = "1500");

    action(LouvreType == "GWR" && ThroatWidth_mm <= 1326 && ThroatLength_mm <= 2168,
           WindLoad = "3000");

    action(LouvreType == "GWR" && (ThroatWidth_mm > 1326 || ThroatLength_mm > 2168),
           WindLoad = "1500");

    action(LouvreType == "GLR" || LouvreType == "GTR",
           WindLoad = "1500");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 10 – SNOW LOAD  (N/m²)
    //
    //  Excel source: snow loads!AA513
    //  Lookup table by [Version × ThroatWidth × ThroatLength × Control
    //                   × ThermalRelease].
    //  Certified SL classes: 125 / 250 / 500 / 1000 / 1500 / >1500.
    //
    //  Key patterns from snow loads sheet:
    //    Pneumatic P*BD / P*OS* → highest SL for given size
    //    Single-acting P*O / P*C → lower SL
    //    Electric M* → lower SL (tested separately)
    //    Manual HE/HI/L → lower SL
    //    Version 2V → separate VdS certification, max SL 1500
    //
    //  Full size × control × release matrix (500+ rows) requires
    //  external Apex for production.  Representative rules below.
    // ══════════════════════════════════════════════════════════════════════
    // P*BD and P*OS* (pressure-locked) → maximum certified snow load
    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           Version != "2V" &&
           ThroatWidth_mm <= 1326 && ThroatLength_mm <= 2035,
           SnowLoad = "1618");

    action((Control == "P1BD"  || Control == "P2BD"  ||
            Control == "P1OSH" || Control == "P2OSH" ||
            Control == "P1OSP" || Control == "P2OSP" ||
            Control == "P1BDD" || Control == "P2BDD" ||
            Control == "P1OSHD"|| Control == "P2OSHD"||
            Control == "P1OSPD"|| Control == "P2OSPD"||
            Control == "MP1OSH"|| Control == "MP2OSH"||
            Control == "MP1OSP"|| Control == "MP2OSP") &&
           Version != "2V" &&
           (ThroatWidth_mm > 1326 || ThroatLength_mm > 2035),
           SnowLoad = "1000");

    // Single-acting pneumatic
    action((Control == "P1O"  || Control == "P2O"  ||
            Control == "P1C"  || Control == "P2C"  ||
            Control == "P1O4" || Control == "P2O4" ||
            Control == "P1C4" || Control == "P2C4") &&
           Version != "2V",
           SnowLoad = "500");

    // Electric motors
    action((Control == "M1B24"  || Control == "M2B24"  ||
            Control == "M1C24"  || Control == "M2C24"  ||
            Control == "M1O24"  || Control == "M2O24"  ||
            Control == "M1B24M" || Control == "M2B24M" ||
            Control == "M1C24J" || Control == "M2C24J" ||
            Control == "M1B24K" || Control == "M2B24K" ||
            Control == "M1B230" || Control == "M2B230" ||
            Control == "M1C230" || Control == "M2C230" ||
            Control == "M1O230" || Control == "M2O230" ||
            Control == "M1B230J"|| Control == "M2B230J"||
            Control == "M1C230J"|| Control == "M2C230J"||
            Control == "M1B24J" || Control == "M2B24J") &&
           Version != "2V",
           SnowLoad = "250");

    // Manual controls
    action((Control == "HE" || Control == "HI" || Control == "L") && Version != "2V",
           SnowLoad = "250");

    // 2V (VdS) version
    action(Version == "2V",
           SnowLoad = "1500");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 11 – U-VALUE  W/(m²K)
    //
    //  Excel source: U-values!K79
    //    =IF(MID(B7,1,2)="CB","X",K77)
    //    K77 = SUM(K68:K76)  – area-weighted U-value across all components
    //
    //  CB* bases → not certified → "X"
    //  For STD / UB* bases:
    //    U-value depends on [LouvreType, Insulation].
    //    Values from U-values sheet weighted calculation (K77).
    //    The calculation is area-weighted and size-dependent; values below
    //    are from the reference configuration (15×15 size, flat roof).
    // ══════════════════════════════════════════════════════════════════════
    // CB* bases → no U-value certified
    action(BaseType == "CB2" || BaseType == "CB3" || BaseType == "CB4",
           UValue = "X");

    // STD / UB* bases → table lookup [LouvreType × Insulation]
    constraint(
        (BaseType == "STD" || BaseType == "UB1" || BaseType == "UB2" ||
         BaseType == "UB3" || BaseType == "UB4" || BaseType == "UB5") →
        table(LouvreType, Insulation, UValue,
            // No insulation (I = "X")
            {"A1B",  "X", "5.51"}, {"A1X",  "X", "5.51"},
            {"A2BD", "X", "4.62"}, {"A2XD", "X", "4.62"},
            {"A2B",  "X", "4.62"}, {"A2X",  "X", "4.62"},
            {"A2I",  "X", "1.87"},
            {"PCR",  "X", "5.72"}, {"POR",  "X", "5.72"},
            {"PC16", "X", "3.43"}, {"PO16", "X", "3.43"},
            {"GWR",  "X", "4.18"},
            {"GLR",  "X", "3.86"}, {"GTR",  "X", "3.86"},
            // With insulation (I = "I")
            {"A1B",  "I", "2.43"}, {"A1X",  "I", "2.43"},
            {"A2BD", "I", "2.30"}, {"A2XD", "I", "2.30"},
            {"A2B",  "I", "2.30"}, {"A2X",  "I", "2.30"},
            {"A2I",  "I", "1.41"},
            {"PCR",  "I", "2.48"}, {"POR",  "I", "2.48"},
            {"PC16", "I", "1.98"}, {"PO16", "I", "1.98"},
            {"GWR",  "I", "2.17"},
            {"GLR",  "I", "2.10"}, {"GTR",  "I", "2.10"}),
        "U-value from louvre type and insulation (STD/UB* bases only)");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 12 – WEIGHT  (kg)
    //
    //  Excel source: weight!C352
    //    =IF(C349=0,"X",SUM(C349,C350,C351))
    //    C349 = base weight   (weight!C349  – HLOOKUP by size × louvre type)
    //    C350 = insulation addon (weight!C350 – only if Insulation="I")
    //    C351 = control addon  (weight!C351  – HLOOKUP by control type × size)
    //
    //  The weight table has base weights by [louvre_family × size_code] and
    //  addon weights by [control_type].  This requires the full lookup table
    //  which is too large to inline in CML.
    //
    //  Sentinel "X" is set here.  Replace with Apex callout or pre-computed
    //  AttributePricing record mapped on the composite size key.
    // ══════════════════════════════════════════════════════════════════════
    action(true, Weight = "X");

    message(Weight == "X",
            "Weight is determined from the factory weight table (weight!C352). " &
            "Implement via Apex invocable action or pre-computed AttributePricing records.",
            "Info");


    // ══════════════════════════════════════════════════════════════════════
    //  SECTION 13 – CONFIGURATION BUSINESS RULES
    // ══════════════════════════════════════════════════════════════════════

    // ── Version restrictions ───────────────────────────────────────────
    exclude(Version != "3S",
            Guards == "IG" || Guards == "IS" || Guards == "BG",
            "External guards (IG/IS/BG) are only available with version 3S.");

    exclude(Version != "3S",
            BurglarGuards == "S",
            "Burglar guard (S) is only available with version 3S.");

    exclude(Version != "3S",
            BaseType == "CB3" || BaseType == "CB4",
            "CB3 and CB4 base types are only available with version 3S.");

    // ── Wall installation ──────────────────────────────────────────────
    exclude(AssemblySituation == "W",
            UpstandDesign != "X",
            "Upstand is not used for wall installation – select 'X' (without upstand).");

    exclude(Version == "2V",
            AssemblySituation == "W",
            "Version 2V (VdS) is not certified for wall installation.");

    // ── CB* base restrictions ──────────────────────────────────────────
    exclude(BaseType == "CB2" || BaseType == "CB3" || BaseType == "CB4",
            InsulatedAdapter == "A",
            "Insulated adapter is not available with conical (CB*) base types.");

    // ── Louvre-specific restrictions ───────────────────────────────────
    exclude(LouvreType == "PC16" || LouvreType == "PO16",
            RemovableLouvre == "R",
            "Externally removable louvre is not available with PC16 or PO16 louvre type.");

    // ── Finish / Coverage dependency ───────────────────────────────────
    exclude(Finish == "X",
            Coverage != "X",
            "Paint coverage can only be specified when a paint finish (PG/PS/PM/S) is selected.");

    require(Coverage != "X",
            Finish != "X",
            "A paint finish must be selected when specifying coverage.");

    // RAL colour required when a painted finish is selected
    message(Finish != "X" && RALColour == "",
            "Please specify a RAL colour number for the selected paint finish.",
            "Warning");

    // ── Informational messages ─────────────────────────────────────────
    message(BaseType == "CB2" || BaseType == "CB3" || BaseType == "CB4",
            "U-value is not certified for conical upstand base types (CB*). U-value field will show 'X'.",
            "Info");

    message(AerodynamicAreaAa < 0.50,
            "Aerodynamic area Aa < 0.50 m². Please verify this unit meets the required smoke exhaust airflow.",
            "Warning");

    message(ThroatWidth_mm >= 2000 || ThroatLength_mm >= 3000,
            "Large-format unit selected. Please confirm structural suitability and contact the factory for lead time.",
            "Info");

    message(LiftingEyes == "Yes",
            "Factory-fitted lifting eyes add approximately 2–4 kg and require pre-order confirmation.",
            "Info");

    message(InsulatedAdapter == "A" && Insulation == "X",
            "Insulated adapter (A) is selected without body insulation (I). " &
            "Confirm this is intentional.",
            "Warning");

}   // end type CO
