    constraint(table(ECO_ThroatLength, ECO_ThroatLength_mm,
        {"10", 705},  {"11", 838},  {"13", 971},  {"14", 1104},
        {"15", 1237}, {"17", 1370}, {"18", 1503}, {"19", 1636},
        {"21", 1769}, {"22", 1902}, {"23", 2035}, {"25", 2168},
        {"26", 2301}, {"27", 2434}, {"29", 2567}, {"30", 2700},
        {"31", 2833}, {"32", 2966}, {"34", 3099}, {"35", 3232},
        {"36", 3365}, {"38", 3498}),
        "Throat length code to mm");


    // ══════════════════════════════════════════════════════════════════════
    //  2.  NUMBER OF LOUVRES
    //  Formula: (ECO_ThroatLength_mm - 40) / 133
    //  Source:  Input!C42
    //
    //  constraint(table(...)) maps each length_mm value to the pre-computed
    //  louvre count. This is the correct CML pattern for a derived integer
    //  computed from another variable via arithmetic.
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ECO_ThroatLength_mm, ECO_NumLouvres,
        {705,  5},  {838,  6},  {971,  7},  {1104, 8},
        {1237, 9},  {1370, 10}, {1503, 11}, {1636, 12},
        {1769, 13}, {1902, 14}, {2035, 15}, {2168, 16},
        {2301, 17}, {2434, 18}, {2567, 19}, {2700, 20},
        {2833, 21}, {2966, 22}, {3099, 23}, {3232, 24},
        {3365, 25}, {3498, 26}),
        "Number of louvres from throat length mm");


    // ══════════════════════════════════════════════════════════════════════
    //  3.  GEOMETRIC AREA Av  (m²)
    //  Source: aerodynamic!C365
    //  Av = Width_mm × Length_mm / 1 000 000
    //  Expressed as a 3-column table: [Width_mm, Length_mm] -> Av
    //  All 14 × 22 = 308 size combinations pre-computed below (rounded 2dp).
    //
    //  Pattern: constraint(table(Width_mm, Length_mm, Av, {...}))
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ECO_ThroatWidth_mm, ECO_ThroatLength_mm, ECO_GeomAreaAv,
        // Width  426 mm
        {426,  705, 0.30}, {426,  838, 0.36}, {426,  971, 0.41}, {426, 1104, 0.47},
        {426, 1237, 0.53}, {426, 1370, 0.58}, {426, 1503, 0.64}, {426, 1636, 0.70},
        {426, 1769, 0.75}, {426, 1902, 0.81}, {426, 2035, 0.87}, {426, 2168, 0.92},
        {426, 2301, 0.98}, {426, 2434, 1.04}, {426, 2567, 1.09}, {426, 2700, 1.15},
        {426, 2833, 1.21}, {426, 2966, 1.26}, {426, 3099, 1.32}, {426, 3232, 1.38},
        {426, 3365, 1.43}, {426, 3498, 1.49},
        // Width  576 mm
        {576,  705, 0.41}, {576,  838, 0.48}, {576,  971, 0.56}, {576, 1104, 0.64},
        {576, 1237, 0.71}, {576, 1370, 0.79}, {576, 1503, 0.87}, {576, 1636, 0.94},
        {576, 1769, 1.02}, {576, 1902, 1.10}, {576, 2035, 1.17}, {576, 2168, 1.25},
        {576, 2301, 1.33}, {576, 2434, 1.40}, {576, 2567, 1.48}, {576, 2700, 1.56},
        {576, 2833, 1.63}, {576, 2966, 1.71}, {576, 3099, 1.78}, {576, 3232, 1.86},
        {576, 3365, 1.94}, {576, 3498, 2.01},
        // Width  726 mm
        {726,  705, 0.51}, {726,  838, 0.61}, {726,  971, 0.70}, {726, 1104, 0.80},
        {726, 1237, 0.90}, {726, 1370, 0.99}, {726, 1503, 1.09}, {726, 1636, 1.19},
        {726, 1769, 1.28}, {726, 1902, 1.38}, {726, 2035, 1.48}, {726, 2168, 1.57},
        {726, 2301, 1.67}, {726, 2434, 1.77}, {726, 2567, 1.86}, {726, 2700, 1.96},
        {726, 2833, 2.06}, {726, 2966, 2.15}, {726, 3099, 2.25}, {726, 3232, 2.35},
        {726, 3365, 2.44}, {726, 3498, 2.54},
        // Width  876 mm
        {876,  705, 0.62}, {876,  838, 0.73}, {876,  971, 0.85}, {876, 1104, 0.97},
        {876, 1237, 1.08}, {876, 1370, 1.20}, {876, 1503, 1.32}, {876, 1636, 1.43},
        {876, 1769, 1.55}, {876, 1902, 1.67}, {876, 2035, 1.78}, {876, 2168, 1.90},
        {876, 2301, 2.02}, {876, 2434, 2.13}, {876, 2567, 2.25}, {876, 2700, 2.37},
        {876, 2833, 2.48}, {876, 2966, 2.60}, {876, 3099, 2.71}, {876, 3232, 2.83},
        {876, 3365, 2.95}, {876, 3498, 3.06},
        // Width 1026 mm
        {1026,  705, 0.72}, {1026,  838, 0.86}, {1026,  971, 1.00}, {1026, 1104, 1.13},
        {1026, 1237, 1.27}, {1026, 1370, 1.41}, {1026, 1503, 1.54}, {1026, 1636, 1.68},
        {1026, 1769, 1.81}, {1026, 1902, 1.95}, {1026, 2035, 2.09}, {1026, 2168, 2.22},
        {1026, 2301, 2.36}, {1026, 2434, 2.50}, {1026, 2567, 2.63}, {1026, 2700, 2.77},
        {1026, 2833, 2.91}, {1026, 2966, 3.04}, {1026, 3099, 3.18}, {1026, 3232, 3.32},
        {1026, 3365, 3.45}, {1026, 3498, 3.59},
        // Width 1176 mm
        {1176,  705, 0.83}, {1176,  838, 0.99}, {1176,  971, 1.14}, {1176, 1104, 1.30},
        {1176, 1237, 1.45}, {1176, 1370, 1.61}, {1176, 1503, 1.77}, {1176, 1636, 1.92},
        {1176, 1769, 2.08}, {1176, 1902, 2.24}, {1176, 2035, 2.39}, {1176, 2168, 2.55},
        {1176, 2301, 2.71}, {1176, 2434, 2.86}, {1176, 2567, 3.02}, {1176, 2700, 3.18},
        {1176, 2833, 3.33}, {1176, 2966, 3.49}, {1176, 3099, 3.65}, {1176, 3232, 3.80},
        {1176, 3365, 3.96}, {1176, 3498, 4.11},
        // Width 1326 mm
        {1326,  705, 0.93}, {1326,  838, 1.11}, {1326,  971, 1.29}, {1326, 1104, 1.46},
        {1326, 1237, 1.64}, {1326, 1370, 1.82}, {1326, 1503, 1.99}, {1326, 1636, 2.17},
        {1326, 1769, 2.35}, {1326, 1902, 2.52}, {1326, 2035, 2.70}, {1326, 2168, 2.87},
        {1326, 2301, 3.05}, {1326, 2434, 3.23}, {1326, 2567, 3.40}, {1326, 2700, 3.58},
        {1326, 2833, 3.76}, {1326, 2966, 3.93}, {1326, 3099, 4.11}, {1326, 3232, 4.28},
        {1326, 3365, 4.46}, {1326, 3498, 4.64},
        // Width 1476 mm
        {1476,  705, 1.04}, {1476,  838, 1.24}, {1476,  971, 1.43}, {1476, 1104, 1.63},
        {1476, 1237, 1.83}, {1476, 1370, 2.02}, {1476, 1503, 2.22}, {1476, 1636, 2.41},
        {1476, 1769, 2.61}, {1476, 1902, 2.81}, {1476, 2035, 3.00}, {1476, 2168, 3.20},
        {1476, 2301, 3.40}, {1476, 2434, 3.59}, {1476, 2567, 3.79}, {1476, 2700, 3.99},
        {1476, 2833, 4.18}, {1476, 2966, 4.38}, {1476, 3099, 4.57}, {1476, 3232, 4.77},
        {1476, 3365, 4.97}, {1476, 3498, 5.16},
        // Width 1626 mm
        {1626,  705, 1.15}, {1626,  838, 1.36}, {1626,  971, 1.58}, {1626, 1104, 1.80},
        {1626, 1237, 2.01}, {1626, 1370, 2.23}, {1626, 1503, 2.44}, {1626, 1636, 2.66},
        {1626, 1769, 2.88}, {1626, 1902, 3.09}, {1626, 2035, 3.31}, {1626, 2168, 3.52},
        {1626, 2301, 3.74}, {1626, 2434, 3.96}, {1626, 2567, 4.17}, {1626, 2700, 4.39},
        {1626, 2833, 4.61}, {1626, 2966, 4.82}, {1626, 3099, 5.04}, {1626, 3232, 5.25},
        {1626, 3365, 5.47}, {1626, 3498, 5.69},
        // Width 1776 mm
        {1776,  705, 1.25}, {1776,  838, 1.49}, {1776,  971, 1.72}, {1776, 1104, 1.96},
        {1776, 1237, 2.20}, {1776, 1370, 2.43}, {1776, 1503, 2.67}, {1776, 1636, 2.91},
        {1776, 1769, 3.14}, {1776, 1902, 3.38}, {1776, 2035, 3.61}, {1776, 2168, 3.85},
        {1776, 2301, 4.09}, {1776, 2434, 4.32}, {1776, 2567, 4.56}, {1776, 2700, 4.80},
        {1776, 2833, 5.03}, {1776, 2966, 5.27}, {1776, 3099, 5.50}, {1776, 3232, 5.74},
        {1776, 3365, 5.98}, {1776, 3498, 6.21},
        // Width 1926 mm
        {1926,  705, 1.36}, {1926,  838, 1.61}, {1926,  971, 1.87}, {1926, 1104, 2.13},
        {1926, 1237, 2.38}, {1926, 1370, 2.64}, {1926, 1503, 2.89}, {1926, 1636, 3.15},
        {1926, 1769, 3.41}, {1926, 1902, 3.66}, {1926, 2035, 3.92}, {1926, 2168, 4.17},
        {1926, 2301, 4.43}, {1926, 2434, 4.69}, {1926, 2567, 4.94}, {1926, 2700, 5.20},
        {1926, 2833, 5.45}, {1926, 2966, 5.71}, {1926, 3099, 5.97}, {1926, 3232, 6.22},
        {1926, 3365, 6.48}, {1926, 3498, 6.73},
        // Width 2000 mm
        {2000,  705, 1.41}, {2000,  838, 1.68}, {2000,  971, 1.94}, {2000, 1104, 2.21},
        {2000, 1237, 2.47}, {2000, 1370, 2.74}, {2000, 1503, 3.01}, {2000, 1636, 3.27},
        {2000, 1769, 3.54}, {2000, 1902, 3.80}, {2000, 2035, 4.07}, {2000, 2168, 4.34},
        {2000, 2301, 4.60}, {2000, 2434, 4.87}, {2000, 2567, 5.13}, {2000, 2700, 5.40},
        {2000, 2833, 5.67}, {2000, 2966, 5.93}, {2000, 3099, 6.20}, {2000, 3232, 6.46},
        {2000, 3365, 6.73}, {2000, 3498, 7.00},
        // Width 2126 mm
        {2126,  705, 1.50}, {2126,  838, 1.78}, {2126,  971, 2.06}, {2126, 1104, 2.35},
        {2126, 1237, 2.63}, {2126, 1370, 2.91}, {2126, 1503, 3.19}, {2126, 1636, 3.47},
        {2126, 1769, 3.76}, {2126, 1902, 4.04}, {2126, 2035, 4.32}, {2126, 2168, 4.61},
        {2126, 2301, 4.89}, {2126, 2434, 5.17}, {2126, 2567, 5.45}, {2126, 2700, 5.74},
        {2126, 2833, 6.02}, {2126, 2966, 6.30}, {2126, 3099, 6.59}, {2126, 3232, 6.87},
        {2126, 3365, 7.15}, {2126, 3498, 7.43},
        // Width 2326 mm
        {2326,  705, 1.64}, {2326,  838, 1.95}, {2326,  971, 2.26}, {2326, 1104, 2.57},
        {2326, 1237, 2.88}, {2326, 1370, 3.19}, {2326, 1503, 3.49}, {2326, 1636, 3.80},
