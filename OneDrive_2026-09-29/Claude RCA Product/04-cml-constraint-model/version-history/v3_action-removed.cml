    @(defaultValue = "POR")
    string ECO_LouvreType = ["A1B", "A1X", "A2BD", "A2XD", "A2B", "A2X", "A2I", "PCR", "POR", "PC16", "PO16", "GWR", "GLR", "GTR"];

    string ECO_RALColour;

    // ──────────────────────────────────────────────────────────────────────
    //  PROXY VARIABLES – hidden intermediates (not PCM attributes)
    //  Declared with formula expressions; engine resolves via table constraint.
    //  @(hidden = true) keeps them off the UI.
    // ──────────────────────────────────────────────────────────────────────
    @(hidden = true)
    decimal(0) ECO_ThroatWidth_mm;

    @(hidden = true)
    decimal(0) ECO_ThroatLength_mm;

    @(hidden = true)
    decimal(0) ECO_ReleaseTemp_int;

    // ──────────────────────────────────────────────────────────────────────
    //  OUTPUT ATTRIBUTES  (PCM attributes – shown on UI, not user-editable)
    //  Values are set by constraint implications and table constraints below.
    // ──────────────────────────────────────────────────────────────────────
    decimal(2) ECO_NumLouvres;
    decimal(2) ECO_GeomAreaAv;
    decimal(2) ECO_AeroAreaAa;
    string     ECO_SnowLoad;
    string     ECO_WindLoad;
    string     ECO_AmbientTempClass;
    decimal(2) ECO_ReleaseTemp;
    string     ECO_OpenPressVent;
    string     ECO_OpenPressSmoke;
    string     ECO_CO2Bottle;
    string     ECO_Weight;
    string     ECO_UValue;


    // ══════════════════════════════════════════════════════════════════════
    //  1.  THROAT CODE → MM  (table constraints)
    //  constraint(table(input, output, {code, mm}, ...)) is the correct
    //  CML syntax for deterministic one-to-one mappings.
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ECO_ThroatWidth, ECO_ThroatWidth_mm,
        {"6",  426},  {"7",  576},  {"9",  726},  {"10", 876},
        {"12", 1026}, {"13", 1176}, {"15", 1326}, {"16", 1476},
        {"18", 1626}, {"19", 1776}, {"21", 1926}, {"22", 2000},
        {"23", 2126}, {"25", 2326}),
