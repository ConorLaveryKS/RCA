    // ══════════════════════════════════════════════════════════════════════
    //  5.  RELEASE TEMPERATURE (°C)
    //  table constraint: ThermalRelease code -> ECO_ReleaseTemp_int
    //  then implication: ECO_ReleaseTemp == ECO_ReleaseTemp_int
    // ══════════════════════════════════════════════════════════════════════
    constraint(table(ECO_ThermalRelease, ECO_ReleaseTemp_int,
        {"FX",     0},
        {"FV68",  68}, {"FS68",  68}, {"FS68S",  68},
        {"F72",   68}, {"F72S",  68}, {"1F72",  68}, {"1F72S", 68}, {"2F72",  68}, {"2F72S", 68},
        {"FV93",  93}, {"FS93",  93}, {"FS93S",  93},
        {"F93",   93}, {"F93S",  93}, {"1F93",  93}, {"1F93S", 93}, {"2F93",  93}, {"2F93S", 93},
        {"FS141",  141}, {"FS141S", 141}, {"F141",   141}, {"F141S",  141},
        {"1F141",  141}, {"1F141S", 141}, {"2F141",  141}, {"2F141S", 141},
        {"FS182",  182}, {"FS182S", 182}, {"F182",   182}, {"F182S",  182},
        {"1F182",  182}, {"1F182S", 182}, {"2F182",  182}, {"2F182S", 182}),
        "Thermal release code to temperature");

    // Bind output attribute to proxy
    constraint(true -> ECO_ReleaseTemp == ECO_ReleaseTemp_int,
               "Release temperature output");


    // ══════════════════════════════════════════════════════════════════════
    //  6.  AMBIENT TEMPERATURE CLASS
    //  Manual → "X"; pneumatic → pass-through; electric → max T(-15)
    //
    //  CML pattern: constraint(condition -> ECO_AmbientTempClass == "value")
    //  For pass-through (AmbientTempClass = AmbientTemp), enumerate each
    //  value explicitly since CML implication requires a literal on the right.
    // ══════════════════════════════════════════════════════════════════════

    // Manual controls → no T class
    constraint(ECO_Control == "HE" || ECO_Control == "HI" || ECO_Control == "L" ->
               ECO_AmbientTempClass == "X",
               "T-class: manual controls not certified");

    // No class requested
    constraint(ECO_AmbientTemp == "X" ->
               ECO_AmbientTempClass == "X",
               "T-class: not requested");

    // Pneumatic: all T classes pass through
    constraint((ECO_Control == "P1O"    || ECO_Control == "P2O"    ||
                ECO_Control == "P1C"    || ECO_Control == "P2C"    ||
                ECO_Control == "P1O4"   || ECO_Control == "P2O4"   ||
                ECO_Control == "P1C4"   || ECO_Control == "P2C4"   ||
                ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_AmbientTemp == "T(00)" ->
               ECO_AmbientTempClass == "T(00)", "T-class T00 pneumatic");

    constraint((ECO_Control == "P1O"    || ECO_Control == "P2O"    ||
                ECO_Control == "P1C"    || ECO_Control == "P2C"    ||
                ECO_Control == "P1O4"   || ECO_Control == "P2O4"   ||
                ECO_Control == "P1C4"   || ECO_Control == "P2C4"   ||
                ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_AmbientTemp == "T(-05)" ->
               ECO_AmbientTempClass == "T(-05)", "T-class T-05 pneumatic");

    constraint((ECO_Control == "P1O"    || ECO_Control == "P2O"    ||
                ECO_Control == "P1C"    || ECO_Control == "P2C"    ||
                ECO_Control == "P1O4"   || ECO_Control == "P2O4"   ||
                ECO_Control == "P1C4"   || ECO_Control == "P2C4"   ||
                ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_AmbientTemp == "T(-15)" ->
               ECO_AmbientTempClass == "T(-15)", "T-class T-15 pneumatic");

    constraint((ECO_Control == "P1O"    || ECO_Control == "P2O"    ||
                ECO_Control == "P1C"    || ECO_Control == "P2C"    ||
                ECO_Control == "P1O4"   || ECO_Control == "P2O4"   ||
                ECO_Control == "P1C4"   || ECO_Control == "P2C4"   ||
                ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_AmbientTemp == "T(-25)" ->
               ECO_AmbientTempClass == "T(-25)", "T-class T-25 pneumatic");

    // Electric: T(-25) not certified → force X
    constraint((ECO_Control == "M1B24"   || ECO_Control == "M2B24"   ||
                ECO_Control == "M1C24"   || ECO_Control == "M2C24"   ||
                ECO_Control == "M1O24"   || ECO_Control == "M2O24"   ||
                ECO_Control == "M1B24M"  || ECO_Control == "M2B24M"  ||
                ECO_Control == "M1C24J"  || ECO_Control == "M2C24J"  ||
                ECO_Control == "M1B24K"  || ECO_Control == "M2B24K"  ||
                ECO_Control == "M1B230"  || ECO_Control == "M2B230"  ||
                ECO_Control == "M1C230"  || ECO_Control == "M2C230"  ||
                ECO_Control == "M1O230"  || ECO_Control == "M2O230"  ||
                ECO_Control == "M1B230J" || ECO_Control == "M2B230J" ||
                ECO_Control == "M1C230J" || ECO_Control == "M2C230J" ||
                ECO_Control == "M1B24J"  || ECO_Control == "M2B24J") &&
               ECO_AmbientTemp == "T(-25)" ->
               ECO_AmbientTempClass == "X",
               "T-class T-25 not certified for electric drives");

    // Electric: T(00)/T(-05)/T(-15) pass through
    constraint((ECO_Control == "M1B24"   || ECO_Control == "M2B24"   ||
                ECO_Control == "M1C24"   || ECO_Control == "M2C24"   ||
                ECO_Control == "M1O24"   || ECO_Control == "M2O24"   ||
                ECO_Control == "M1B24M"  || ECO_Control == "M2B24M"  ||
                ECO_Control == "M1C24J"  || ECO_Control == "M2C24J"  ||
                ECO_Control == "M1B24K"  || ECO_Control == "M2B24K"  ||
                ECO_Control == "M1B230"  || ECO_Control == "M2B230"  ||
                ECO_Control == "M1C230"  || ECO_Control == "M2C230"  ||
                ECO_Control == "M1O230"  || ECO_Control == "M2O230"  ||
                ECO_Control == "M1B230J" || ECO_Control == "M2B230J" ||
                ECO_Control == "M1C230J" || ECO_Control == "M2C230J" ||
                ECO_Control == "M1B24J"  || ECO_Control == "M2B24J") &&
               (ECO_AmbientTemp == "T(00)"  ||
                ECO_AmbientTemp == "T(-05)" ||
                ECO_AmbientTemp == "T(-15)") ->
               ECO_AmbientTempClass == ECO_AmbientTemp,
               "T-class pass-through for electric drives");

    message((ECO_Control == "M1B24" || ECO_Control == "M2B24" ||
             ECO_Control == "M1C24" || ECO_Control == "M2C24" ||
             ECO_Control == "M1B230"|| ECO_Control == "M2B230"||
             ECO_Control == "M1C230"|| ECO_Control == "M2C230") &&
            ECO_AmbientTemp == "T(-25)",
            "T(-25) is not certified for electric motor drives. T(-15) is the lowest certified class.",
            "Warning");


    // ══════════════════════════════════════════════════════════════════════
    //  7.  CO2 BOTTLE SIZE  (g)  – constraint implication per branch
    // ══════════════════════════════════════════════════════════════════════

    // No-CO2 controls
    constraint((ECO_Control == "HE"      || ECO_Control == "HI"      ||
                ECO_Control == "L"       || ECO_Control == "P1O"     ||
                ECO_Control == "P2O"     || ECO_Control == "P1C"     ||
                ECO_Control == "P2C"     || ECO_Control == "P1O4"    ||
                ECO_Control == "P2O4"    || ECO_Control == "P1C4"    ||
                ECO_Control == "P2C4"    || ECO_Control == "M1B24"   ||
                ECO_Control == "M2B24"   || ECO_Control == "M1C24"   ||
                ECO_Control == "M2C24"   || ECO_Control == "M1O24"   ||
                ECO_Control == "M2O24"   || ECO_Control == "M1B24M"  ||
                ECO_Control == "M2B24M"  || ECO_Control == "M1C24J"  ||
                ECO_Control == "M2C24J"  || ECO_Control == "M1B24K"  ||
                ECO_Control == "M2B24K"  || ECO_Control == "M1B230"  ||
                ECO_Control == "M2B230"  || ECO_Control == "M1C230"  ||
                ECO_Control == "M2C230"  || ECO_Control == "M1O230"  ||
                ECO_Control == "M2O230"  || ECO_Control == "M1B230J" ||
                ECO_Control == "M2B230J" || ECO_Control == "M1C230J" ||
                ECO_Control == "M2C230J" || ECO_Control == "M1B24J"  ||
                ECO_Control == "M2B24J") ->
               ECO_CO2Bottle == "X",
               "CO2: not required for this control type");

    // FX or FV** → no CO2
    constraint(ECO_ThermalRelease == "FX" ||
               ECO_ThermalRelease == "FV68" || ECO_ThermalRelease == "FV93" ->
               ECO_CO2Bottle == "X",
               "CO2: no thermal release element");

    // Locked/OS + fusible-link (F*, 1F*, 2F*) → no CO2
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               (ECO_ThermalRelease == "F72"    || ECO_ThermalRelease == "F72S"   ||
                ECO_ThermalRelease == "F93"    || ECO_ThermalRelease == "F93S"   ||
                ECO_ThermalRelease == "F141"   || ECO_ThermalRelease == "F141S"  ||
                ECO_ThermalRelease == "F182"   || ECO_ThermalRelease == "F182S"  ||
                ECO_ThermalRelease == "1F72"   || ECO_ThermalRelease == "1F72S"  ||
                ECO_ThermalRelease == "1F93"   || ECO_ThermalRelease == "1F93S"  ||
                ECO_ThermalRelease == "1F141"  || ECO_ThermalRelease == "1F141S" ||
                ECO_ThermalRelease == "1F182"  || ECO_ThermalRelease == "1F182S" ||
                ECO_ThermalRelease == "2F72"   || ECO_ThermalRelease == "2F72S"  ||
                ECO_ThermalRelease == "2F93"   || ECO_ThermalRelease == "2F93S"  ||
                ECO_ThermalRelease == "2F141"  || ECO_ThermalRelease == "2F141S" ||
                ECO_ThermalRelease == "2F182"  || ECO_ThermalRelease == "2F182S") ->
               ECO_CO2Bottle == "X",
               "CO2: fusible-link release does not use CO2");

    // FS68/FS93 TVV + locked/OS + small unit → 20 g
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               (ECO_ThermalRelease == "FS68"  || ECO_ThermalRelease == "FS68S" ||
                ECO_ThermalRelease == "FS93"  || ECO_ThermalRelease == "FS93S") &&
               ECO_ThroatWidth_mm < 1926 && ECO_ThroatLength_mm < 3099 ->
               ECO_CO2Bottle == "20",
               "CO2: 20g for FS68/FS93 small/medium unit");

    // FS68/FS93 TVV + locked/OS + large unit → 40 g
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               (ECO_ThermalRelease == "FS68"  || ECO_ThermalRelease == "FS68S" ||
                ECO_ThermalRelease == "FS93"  || ECO_ThermalRelease == "FS93S") &&
               (ECO_ThroatWidth_mm >= 1926 || ECO_ThroatLength_mm >= 3099) ->
               ECO_CO2Bottle == "40",
               "CO2: 40g for FS68/FS93 large unit");

    // FS141/FS182 TVV → 28 g
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               (ECO_ThermalRelease == "FS141"  || ECO_ThermalRelease == "FS141S" ||
                ECO_ThermalRelease == "FS182"  || ECO_ThermalRelease == "FS182S") ->
               ECO_CO2Bottle == "28",
               "CO2: 28g for FS141/FS182");


    // ══════════════════════════════════════════════════════════════════════
    //  8.  OPENING PRESSURES  (bar or "X")
    // ══════════════════════════════════════════════════════════════════════

    // Non-pressure controls → "X"
    constraint((ECO_Control == "HE"      || ECO_Control == "HI"      ||
                ECO_Control == "L"       || ECO_Control == "P1O"     ||
                ECO_Control == "P2O"     || ECO_Control == "P1C"     ||
                ECO_Control == "P2C"     || ECO_Control == "P1O4"    ||
                ECO_Control == "P2O4"    || ECO_Control == "P1C4"    ||
                ECO_Control == "P2C4"    || ECO_Control == "M1B24"   ||
                ECO_Control == "M2B24"   || ECO_Control == "M1C24"   ||
                ECO_Control == "M2C24"   || ECO_Control == "M1O24"   ||
                ECO_Control == "M2O24"   || ECO_Control == "M1B24M"  ||
                ECO_Control == "M2B24M"  || ECO_Control == "M1C24J"  ||
                ECO_Control == "M2C24J"  || ECO_Control == "M1B24K"  ||
                ECO_Control == "M2B24K"  || ECO_Control == "M1B230"  ||
                ECO_Control == "M2B230"  || ECO_Control == "M1C230"  ||
                ECO_Control == "M2C230"  || ECO_Control == "M1O230"  ||
                ECO_Control == "M2O230"  || ECO_Control == "M1B230J" ||
                ECO_Control == "M2B230J" || ECO_Control == "M1C230J" ||
                ECO_Control == "M2C230J" || ECO_Control == "M1B24J"  ||
                ECO_Control == "M2B24J") ->
               ECO_OpenPressVent == "X" && ECO_OpenPressSmoke == "X",
               "Opening pressure not applicable for this control type");

    // Locked/OS controls – ventilation always 2 bar minimum
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") ->
               ECO_OpenPressVent == "2",
               "Ventilation opening pressure minimum 2 bar");

    // Smoke pressure – small unit (Width ≤ 1326 AND Length ≤ 2035)
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_ThroatWidth_mm <= 1326 && ECO_ThroatLength_mm <= 2035 ->
               ECO_OpenPressSmoke == "2",
               "Smoke pressure 2 bar for small unit");

    // Smoke pressure – medium unit
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ((ECO_ThroatWidth_mm >= 1476 && ECO_ThroatWidth_mm <= 1776) ||
                (ECO_ThroatLength_mm >= 2168 && ECO_ThroatLength_mm <= 2567)) ->
               ECO_OpenPressSmoke == "4.9",
               "Smoke pressure 4.9 bar for medium unit");

    // Smoke pressure – large unit
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               (ECO_ThroatWidth_mm >= 1926 || ECO_ThroatLength_mm >= 2700) ->
               ECO_OpenPressSmoke == "9.8",
               "Smoke pressure 9.8 bar for large unit");


    // ══════════════════════════════════════════════════════════════════════
    //  9.  WIND LOAD CLASS  (N/m²)
    // ══════════════════════════════════════════════════════════════════════
    constraint((ECO_LouvreType == "A1B"  || ECO_LouvreType == "A1X"  ||
                ECO_LouvreType == "A2BD" || ECO_LouvreType == "A2XD" ||
                ECO_LouvreType == "A2B"  || ECO_LouvreType == "A2X"  ||
                ECO_LouvreType == "A2I") ->
               ECO_WindLoad == "4000",
               "Wind load: aluminium louvres WL 4000");

    constraint((ECO_LouvreType == "PCR" || ECO_LouvreType == "POR") &&
               ECO_ThroatWidth_mm <= 1776 && ECO_ThroatLength_mm <= 2700 ->
               ECO_WindLoad == "4000",
               "Wind load: PCR/POR small/medium WL 4000");

    constraint((ECO_LouvreType == "PCR" || ECO_LouvreType == "POR") &&
               (ECO_ThroatWidth_mm > 1776 || ECO_ThroatLength_mm > 2700) ->
               ECO_WindLoad == "3000",
               "Wind load: PCR/POR large WL 3000");

    constraint((ECO_LouvreType == "PC16" || ECO_LouvreType == "PO16") ->
               ECO_WindLoad == "1500",
               "Wind load: PC16/PO16 WL 1500");

    constraint(ECO_LouvreType == "GWR" &&
               ECO_ThroatWidth_mm <= 1326 && ECO_ThroatLength_mm <= 2168 ->
               ECO_WindLoad == "3000",
               "Wind load: GWR small WL 3000");

    constraint(ECO_LouvreType == "GWR" &&
               (ECO_ThroatWidth_mm > 1326 || ECO_ThroatLength_mm > 2168) ->
               ECO_WindLoad == "1500",
               "Wind load: GWR large WL 1500");

    constraint((ECO_LouvreType == "GLR" || ECO_LouvreType == "GTR") ->
               ECO_WindLoad == "1500",
               "Wind load: glass louvres WL 1500");


    // ══════════════════════════════════════════════════════════════════════
    //  10. SNOW LOAD  (N/m²)
    // ══════════════════════════════════════════════════════════════════════
    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_Version != "2V" &&
               ECO_ThroatWidth_mm <= 1326 && ECO_ThroatLength_mm <= 2035 ->
               ECO_SnowLoad == "1618",
               "Snow load 1618 N/m2 for locked/OS controls small unit");

    constraint((ECO_Control == "P1BD"   || ECO_Control == "P2BD"   ||
                ECO_Control == "P1OSH"  || ECO_Control == "P2OSH"  ||
                ECO_Control == "P1OSP"  || ECO_Control == "P2OSP"  ||
                ECO_Control == "P1BDD"  || ECO_Control == "P2BDD"  ||
                ECO_Control == "P1OSHD" || ECO_Control == "P2OSHD" ||
                ECO_Control == "P1OSPD" || ECO_Control == "P2OSPD" ||
                ECO_Control == "MP1OSH" || ECO_Control == "MP2OSH" ||
                ECO_Control == "MP1OSP" || ECO_Control == "MP2OSP") &&
               ECO_Version != "2V" &&
               (ECO_ThroatWidth_mm > 1326 || ECO_ThroatLength_mm > 2035) ->
               ECO_SnowLoad == "1000",
               "Snow load 1000 N/m2 for locked/OS controls large unit");

    constraint((ECO_Control == "P1O"  || ECO_Control == "P2O"  ||
                ECO_Control == "P1C"  || ECO_Control == "P2C"  ||
                ECO_Control == "P1O4" || ECO_Control == "P2O4" ||
                ECO_Control == "P1C4" || ECO_Control == "P2C4") &&
               ECO_Version != "2V" ->
               ECO_SnowLoad == "500",
               "Snow load 500 N/m2 for single-acting pneumatic");

    constraint((ECO_Control == "M1B24"   || ECO_Control == "M2B24"   ||
                ECO_Control == "M1C24"   || ECO_Control == "M2C24"   ||
                ECO_Control == "M1O24"   || ECO_Control == "M2O24"   ||
                ECO_Control == "M1B24M"  || ECO_Control == "M2B24M"  ||
                ECO_Control == "M1C24J"  || ECO_Control == "M2C24J"  ||
                ECO_Control == "M1B24K"  || ECO_Control == "M2B24K"  ||
                ECO_Control == "M1B230"  || ECO_Control == "M2B230"  ||
                ECO_Control == "M1C230"  || ECO_Control == "M2C230"  ||
                ECO_Control == "M1O230"  || ECO_Control == "M2O230"  ||
                ECO_Control == "M1B230J" || ECO_Control == "M2B230J" ||
                ECO_Control == "M1C230J" || ECO_Control == "M2C230J" ||
                ECO_Control == "M1B24J"  || ECO_Control == "M2B24J"  ||
                ECO_Control == "HE"      || ECO_Control == "HI"      ||
                ECO_Control == "L") &&
               ECO_Version != "2V" ->
               ECO_SnowLoad == "250",
               "Snow load 250 N/m2 for electric and manual controls");

    constraint(ECO_Version == "2V" ->
               ECO_SnowLoad == "1500",
               "Snow load 1500 N/m2 for 2V VdS version");


    // ══════════════════════════════════════════════════════════════════════
    //  11. U-VALUE  W/(m²K)
    // ══════════════════════════════════════════════════════════════════════
    constraint((ECO_BaseType == "CB2" || ECO_BaseType == "CB3" || ECO_BaseType == "CB4") ->
               ECO_UValue == "X",
               "U-value not certified for conical base types");

    constraint(ECO_BaseType != "CB2" && ECO_BaseType != "CB3" && ECO_BaseType != "CB4" ->
               table(ECO_LouvreType, ECO_Insulation, ECO_UValue,
                   {"A1B",  "X", "5.51"}, {"A1X",  "X", "5.51"},
                   {"A2BD", "X", "4.62"}, {"A2XD", "X", "4.62"},
                   {"A2B",  "X", "4.62"}, {"A2X",  "X", "4.62"},
                   {"A2I",  "X", "1.87"},
                   {"PCR",  "X", "5.72"}, {"POR",  "X", "5.72"},
                   {"PC16", "X", "3.43"}, {"PO16", "X", "3.43"},
                   {"GWR",  "X", "4.18"},
                   {"GLR",  "X", "3.86"}, {"GTR",  "X", "3.86"},
                   {"A1B",  "I", "2.43"}, {"A1X",  "I", "2.43"},
                   {"A2BD", "I", "2.30"}, {"A2XD", "I", "2.30"},
                   {"A2B",  "I", "2.30"}, {"A2X",  "I", "2.30"},
                   {"A2I",  "I", "1.41"},
                   {"PCR",  "I", "2.48"}, {"POR",  "I", "2.48"},
                   {"PC16", "I", "1.98"}, {"PO16", "I", "1.98"},
                   {"GWR",  "I", "2.17"},
                   {"GLR",  "I", "2.10"}, {"GTR",  "I", "2.10"}),
               "U-value by louvre type and insulation for STD and UB bases");


    // ══════════════════════════════════════════════════════════════════════
    //  12. WEIGHT – sentinel; full table requires Apex callout
    // ══════════════════════════════════════════════════════════════════════
    constraint(true -> ECO_Weight == "X",
               "Weight requires Apex callout to factory weight table");

    message(true,
            "Weight is determined from the factory weight table. Implement via Apex invocable action.",
            "Info");


    // ══════════════════════════════════════════════════════════════════════
    //  13. BUSINESS RULES
    // ══════════════════════════════════════════════════════════════════════

    constraint(ECO_Version != "3S" ->
               ECO_Guards != "IG" && ECO_Guards != "IS" && ECO_Guards != "BG",
               "External guards IG/IS/BG are only available with version 3S.");

    constraint(ECO_Version != "3S" ->
               ECO_BurglarGuards != "S",
               "Burglar guard S is only available with version 3S.");

    constraint(ECO_Version != "3S" ->
               ECO_BaseType != "CB3" && ECO_BaseType != "CB4",
               "CB3 and CB4 base types are only available with version 3S.");

    constraint(ECO_AssemblySituation == "W" -> ECO_UpstandDesign == "X",
               "Upstand is not used for wall installation. Select Without upstand X.");

    constraint(ECO_Version == "2V" -> ECO_AssemblySituation != "W",
               "Version 2V is not certified for wall installation.");

    constraint((ECO_BaseType == "CB2" || ECO_BaseType == "CB3" || ECO_BaseType == "CB4") ->
               ECO_InsulatedAdapter != "A",
               "Insulated adapter not available with conical base types CB2/CB3/CB4.");

    constraint((ECO_LouvreType == "PC16" || ECO_LouvreType == "PO16") ->
               ECO_RemovableLouvre != "R",
               "Removable louvre not available with PC16 or PO16 louvre type.");

    constraint(ECO_Finish == "X" -> ECO_Coverage == "X",
               "Paint coverage can only be specified when a paint finish is selected.");

    constraint(ECO_Coverage != "X" -> ECO_Finish != "X",
               "A paint finish must be selected when specifying coverage.");

    message(ECO_Finish != "X" && ECO_RALColour == "",
            "Please specify a RAL colour number for the selected paint finish.",
            "Warning");

    message(ECO_BaseType == "CB2" || ECO_BaseType == "CB3" || ECO_BaseType == "CB4",
            "U-value is not certified for conical upstand base types. ECO_UValue shows X.",
            "Info");

    message(ECO_AeroAreaAa < 0.50,
            "Aerodynamic area Aa is below 0.50 m2. Please verify smoke exhaust requirements.",
            "Warning");

    message(ECO_ThroatWidth_mm >= 2000 || ECO_ThroatLength_mm >= 3000,
            "Large-format unit selected. Please confirm structural suitability with the factory.",
            "Info");

    message(ECO_LiftingEyes == "Yes",
            "Lifting eyes add approximately 2 to 4 kg and require pre-order confirmation.",
            "Info");

    message(ECO_InsulatedAdapter == "A" && ECO_Insulation == "X",
            "Insulated adapter A selected without body insulation I. Confirm this is intentional.",
            "Warning");

    // ══════════════════════════════════════════════════════════════════════
    //  14. COLUMN G VALIDATIONS – from data sheet (ECO_Tech_Configurator)
    //  All rules translated directly from data!E16:E346 formulas.
    //  Source column: Input column G = IF(data!Ex=TRUE,"Okay","False")
    // ══════════════════════════════════════════════════════════════════════

    // ── WIDTH RESTRICTIONS (data!E16-E20) ─────────────────────────────

    // E16/E27: Width 19/21/22/23/25 not available with A1* louvres
    constraint((ECO_ThroatWidth == "19" || ECO_ThroatWidth == "21" ||
                ECO_ThroatWidth == "22" || ECO_ThroatWidth == "23" || ECO_ThroatWidth == "25") ->
               ECO_LouvreType != "A1B" && ECO_LouvreType != "A1X",
               "Width 19/21/22/23/25 is not available with A1B or A1X louvres.");

    // E17/E28: Width 19/21/22/23/25 not available with G*R louvres
    constraint((ECO_ThroatWidth == "19" || ECO_ThroatWidth == "21" ||
                ECO_ThroatWidth == "22" || ECO_ThroatWidth == "23" || ECO_ThroatWidth == "25") ->
               ECO_LouvreType != "GWR" && ECO_LouvreType != "GLR" && ECO_LouvreType != "GTR",
               "Width 19/21/22/23/25 is not available with glass louvres GWR/GLR/GTR.");

    // E18/E29: Width 6 not available with A2BD or A2XD
    constraint(ECO_ThroatWidth == "6" ->
               ECO_LouvreType != "A2BD" && ECO_LouvreType != "A2XD",
               "Width 6 is not available with A2BD or A2XD louvres.");

    // E19: 2V version only from width 7 to 25 – width 6 not allowed
    constraint(ECO_Version == "2V" -> ECO_ThroatWidth != "6",
               "Version 2V is not available with width 6. Minimum width is 7 (576 mm).");

    // E20: Width 6 only with version 3S
    constraint(ECO_ThroatWidth == "6" -> ECO_Version == "3S",
               "Width 6 (426 mm) is only available with version 3S.");

    // ── LENGTH RESTRICTIONS (data!E23-E24) ────────────────────────────

    // E23: Lengths 34/35/36/38 not available with version 3D
    constraint(ECO_Version == "3D" ->
               ECO_ThroatLength != "34" && ECO_ThroatLength != "35" &&
               ECO_ThroatLength != "36" && ECO_ThroatLength != "38",
               "Lengths 34/35/36/38 (3099-3498 mm) are not available with version 3D.");

    // E24: 2V version only from length 10 to 32 – lengths 34/35/36/38 not allowed
    constraint(ECO_Version == "2V" ->
               ECO_ThroatLength != "34" && ECO_ThroatLength != "35" &&
               ECO_ThroatLength != "36" && ECO_ThroatLength != "38",
               "Version 2V is only available up to length 32 (2966 mm).");

    // ── LOUVRE TYPE RESTRICTIONS (data!E31-E35) ───────────────────────

    // E31: A2I louvre only with version 3E or 3S
    constraint(ECO_LouvreType == "A2I" ->
               ECO_Version == "3E" || ECO_Version == "3S",
               "A2I (insulated aluminium) louvre is only available with version 3E or 3S.");

    // E33: PC16/PO16 only with version 3E or 3S
    constraint((ECO_LouvreType == "PC16" || ECO_LouvreType == "PO16") ->
               ECO_Version == "3E" || ECO_Version == "3S",
               "PC16 and PO16 (16 mm polycarbonate) louvres are only available with version 3E or 3S.");

    // E34: Version 3D not with A2B, A2X, A2I, PC16, PO16
    constraint(ECO_Version == "3D" ->
               ECO_LouvreType != "A2B"  && ECO_LouvreType != "A2X"  &&
               ECO_LouvreType != "A2I"  && ECO_LouvreType != "PC16" &&
               ECO_LouvreType != "PO16",
               "Version 3D is not available with A2B, A2X, A2I, PC16, or PO16 louvres.");

    // E35: 3D and 2V + wall installation + PC16/PO16 not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" ->
               ECO_LouvreType != "PC16" && ECO_LouvreType != "PO16",
               "PC16 and PO16 louvres are not allowed with version 3D or 2V in wall installation.");

    // ── THERMAL RELEASE RESTRICTIONS (data!E100-E124) ─────────────────

    // E100: Version 2V only with FS68 or FS93
    constraint(ECO_Version == "2V" ->
               ECO_ThermalRelease == "FS68" || ECO_ThermalRelease == "FS93",
               "Version 2V only supports FS68 or FS93 thermal release.");

    // E101: F182°C family not for 3D, 3E, 2V versions
    constraint((ECO_Version == "3D" || ECO_Version == "3E" || ECO_Version == "2V") ->
               ECO_ThermalRelease != "F182"   && ECO_ThermalRelease != "F182S"  &&
               ECO_ThermalRelease != "1F182"  && ECO_ThermalRelease != "1F182S" &&
               ECO_ThermalRelease != "2F182"  && ECO_ThermalRelease != "2F182S" &&
               ECO_ThermalRelease != "FS182"  && ECO_ThermalRelease != "FS182S",
               "182 degree thermal release is not available with versions 3D, 3E, or 2V.");

    // E104: Version 3D only with FS68, FS93 (combined with E106 sprinkler shield rule)
    constraint(ECO_Version == "3D" ->
               ECO_ThermalRelease == "FS68" || ECO_ThermalRelease == "FS93",
               "Version 3D only supports FS68 or FS93 thermal release (no sprinkler shield variant).");

    // E106: 3D, 3E, 2V not with sprinkler shield (codes ending with S: F*S, FS*S, 1F*S, 2F*S)
    constraint((ECO_Version == "3D" || ECO_Version == "3E" || ECO_Version == "2V") ->
               ECO_ThermalRelease != "F72S"   && ECO_ThermalRelease != "F93S"   &&
               ECO_ThermalRelease != "F141S"  && ECO_ThermalRelease != "F182S"  &&
               ECO_ThermalRelease != "1F72S"  && ECO_ThermalRelease != "1F93S"  &&
               ECO_ThermalRelease != "1F141S" && ECO_ThermalRelease != "1F182S" &&
               ECO_ThermalRelease != "2F72S"  && ECO_ThermalRelease != "2F93S"  &&
               ECO_ThermalRelease != "2F141S" && ECO_ThermalRelease != "2F182S" &&
               ECO_ThermalRelease != "FS68S"  && ECO_ThermalRelease != "FS93S"  &&
               ECO_ThermalRelease != "FS141S" && ECO_ThermalRelease != "FS182S",
               "Sprinkler shield variants (codes ending in S) are not available with versions 3D, 3E, or 2V.");

    // E107: FV68 and FV93 only with P*C or P*C4 control
    constraint((ECO_ThermalRelease == "FV68" || ECO_ThermalRelease == "FV93") ->
               ECO_Control == "P1C" || ECO_Control == "P2C" ||
               ECO_Control == "P1C4" || ECO_Control == "P2C4",
               "FV68 and FV93 (fusible exhaust valve) are only available with P1C, P2C, P1C4, or P2C4 control.");

    // E111: 1F** or 2F** not possible with length 10 + (P**4 or P*BD or P*BDD)
    constraint((ECO_ThroatLength == "10") &&
               (ECO_Control == "P1O4"  || ECO_Control == "P2O4"  ||
                ECO_Control == "P1C4"  || ECO_Control == "P2C4"  ||
                ECO_Control == "P1BD"  || ECO_Control == "P2BD"  ||
                ECO_Control == "P1BDD" || ECO_Control == "P2BDD") ->
               ECO_ThermalRelease != "1F72"  && ECO_ThermalRelease != "1F72S"  &&
               ECO_ThermalRelease != "1F93"  && ECO_ThermalRelease != "1F93S"  &&
               ECO_ThermalRelease != "1F141" && ECO_ThermalRelease != "1F141S" &&
               ECO_ThermalRelease != "1F182" && ECO_ThermalRelease != "1F182S" &&
               ECO_ThermalRelease != "2F72"  && ECO_ThermalRelease != "2F72S"  &&
               ECO_ThermalRelease != "2F93"  && ECO_ThermalRelease != "2F93S"  &&
               ECO_ThermalRelease != "2F141" && ECO_ThermalRelease != "2F141S" &&
               ECO_ThermalRelease != "2F182" && ECO_ThermalRelease != "2F182S",
               "1F** and 2F** thermal release not available with length 10 and P**4 / P*BD / P*BDD controls.");

    // E112: FS** not possible with length 10 or 11 + P*BD or P*BDD
    constraint((ECO_ThroatLength == "10" || ECO_ThroatLength == "11") &&
               (ECO_Control == "P1BD"  || ECO_Control == "P2BD"  ||
                ECO_Control == "P1BDD" || ECO_Control == "P2BDD") ->
               ECO_ThermalRelease != "FS68"   && ECO_ThermalRelease != "FS93"   &&
               ECO_ThermalRelease != "FS141"  && ECO_ThermalRelease != "FS182"  &&
               ECO_ThermalRelease != "FS68S"  && ECO_ThermalRelease != "FS93S"  &&
               ECO_ThermalRelease != "FS141S" && ECO_ThermalRelease != "FS182S",
               "FS** thermal release not available with lengths 10 or 11 and P*BD or P*BDD controls.");

    // E113: 1F** or 2F** not with length 10 and M*B24K
    constraint(ECO_ThroatLength == "10" &&
               (ECO_Control == "M1B24K" || ECO_Control == "M2B24K") ->
               ECO_ThermalRelease != "1F72"  && ECO_ThermalRelease != "1F72S"  &&
               ECO_ThermalRelease != "1F93"  && ECO_ThermalRelease != "1F93S"  &&
               ECO_ThermalRelease != "1F141" && ECO_ThermalRelease != "1F141S" &&
               ECO_ThermalRelease != "1F182" && ECO_ThermalRelease != "1F182S" &&
               ECO_ThermalRelease != "2F72"  && ECO_ThermalRelease != "2F72S"  &&
               ECO_ThermalRelease != "2F93"  && ECO_ThermalRelease != "2F93S"  &&
               ECO_ThermalRelease != "2F141" && ECO_ThermalRelease != "2F141S" &&
               ECO_ThermalRelease != "2F182" && ECO_ThermalRelease != "2F182S",
               "1F** and 2F** thermal release not available with length 10 and M*B24K control.");

    // E114-E124: 2F** not with width 6 and specific single-motor controls
    constraint(ECO_ThroatWidth == "6" &&
               (ECO_Control == "M1B24"   || ECO_Control == "M1C24"   ||
                ECO_Control == "M1O24"   || ECO_Control == "MP1OSH"  ||
                ECO_Control == "MP1OSP"  || ECO_Control == "M2B24K"  ||
                ECO_Control == "M1B230"  || ECO_Control == "M1C230"  ||
                ECO_Control == "M1O230"  || ECO_Control == "M1C24J"  ||
                ECO_Control == "M1C230J") ->
               ECO_ThermalRelease != "2F72"  && ECO_ThermalRelease != "2F72S"  &&
               ECO_ThermalRelease != "2F93"  && ECO_ThermalRelease != "2F93S"  &&
               ECO_ThermalRelease != "2F141" && ECO_ThermalRelease != "2F141S" &&
               ECO_ThermalRelease != "2F182" && ECO_ThermalRelease != "2F182S",
               "2F** thermal release not available with width 6 and single-motor controls (M1*).");

    // ── INSULATION RESTRICTIONS (data!E143-E147) ──────────────────────

    // E144: Version 3D not with insulation
    constraint(ECO_Version == "3D" -> ECO_Insulation != "I",
               "Insulation is not available with version 3D.");

    // E145: Version 2V not with insulation
    constraint(ECO_Version == "2V" -> ECO_Insulation != "I",
               "Insulation is not available with version 2V.");

    // E147: Insulation ONLY available with PC16, PO16, or A2I louvres
    constraint(ECO_Insulation == "I" ->
               ECO_LouvreType == "PC16" || ECO_LouvreType == "PO16" || ECO_LouvreType == "A2I",
               "Body insulation (I) is only available with PC16, PO16, or A2I louvres.");

    // ── INSULATED ADAPTER RESTRICTIONS (data!E240) ────────────────────

    // E240: Insulated adapter not with version 2V
    constraint(ECO_InsulatedAdapter == "A" -> ECO_Version != "2V",
               "Insulated adapter is not available with version 2V.");

    // ── BURGLAR GUARD RESTRICTIONS (data!E258) ────────────────────────

    // E258: Burglar guard S not with STD base (requires minimum UB1)
    constraint(ECO_BurglarGuards == "S" -> ECO_BaseType != "STD",
               "Burglar guard S requires minimum UB1 base. Not available with STD base.");

    // ── UPSTAND DESIGN RESTRICTIONS (data!E272-E273) ──────────────────

    // E272: Conical upstand C250 not with CB* base
    constraint(ECO_UpstandDesign == "C250" ->
               ECO_BaseType != "CB2" && ECO_BaseType != "CB3" && ECO_BaseType != "CB4",
               "Conical upstand C250 is not available with conical base types CB2/CB3/CB4.");

    // E273: Conical upstand C350 not with CB* base
    constraint(ECO_UpstandDesign == "C350" ->
               ECO_BaseType != "CB2" && ECO_BaseType != "CB3" && ECO_BaseType != "CB4",
               "Conical upstand C350 is not available with conical base types CB2/CB3/CB4.");

    // ── ASSEMBLY SITUATION RESTRICTIONS (data!E277-E284) ──────────────

    // E277: 3D and 2V + wall + STD base + insulation not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" && ECO_BaseType == "STD" ->
               ECO_Insulation != "I",
               "Wall installation with STD base and insulation is not allowed for versions 3D or 2V.");

    // E278: 3D and 2V + wall + UB* base + insulation not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" &&
               (ECO_BaseType == "UB1" || ECO_BaseType == "UB2" || ECO_BaseType == "UB3" ||
                ECO_BaseType == "UB4" || ECO_BaseType == "UB5") ->
               ECO_Insulation != "I",
               "Wall installation with UB* base and insulation is not allowed for versions 3D or 2V.");

    // E279: 3D and 2V + wall + CB2 base + insulation not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" && ECO_BaseType == "CB2" ->
               ECO_Insulation != "I",
               "Wall installation with CB2 base and insulation is not allowed for versions 3D or 2V.");

    // E280: 3D, 3E and 2V + wall + insulated adapter + insulation not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "3E" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" && ECO_InsulatedAdapter == "A" ->
               ECO_Insulation != "I",
               "Wall installation with insulated adapter and body insulation is not allowed for versions 3D, 3E, or 2V.");

    // E283: 3D, 3E and 2V + wall + M*B24K not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "3E" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" ->
               ECO_Control != "M1B24K" && ECO_Control != "M2B24K",
               "M1B24K and M2B24K controls are not allowed in wall installation for versions 3D, 3E, or 2V.");

    // E284: 3D, 3E and 2V + wall + MP*OS* not allowed
    constraint((ECO_Version == "3D" || ECO_Version == "3E" || ECO_Version == "2V") &&
               ECO_AssemblySituation == "W" ->
               ECO_Control != "MP1OSH" && ECO_Control != "MP2OSH" &&
               ECO_Control != "MP1OSP" && ECO_Control != "MP2OSP",
               "MP*OSH and MP*OSP controls are not allowed in wall installation for versions 3D, 3E, or 2V.");

    // ── LIFTING EYES RESTRICTION (data!E286) ──────────────────────────

    // E286: Lifting eyes not allowed when body insulation is selected
    constraint(ECO_LiftingEyes == "Yes" -> ECO_Insulation != "I",
               "Lifting eyes are not available when body insulation (I) is selected.");

    // ── SNOW LOAD OUTPUT WARNINGS (data!E298-E299) ────────────────────

    // E298: Version 2V requires minimum snow load SL 500
    // Our model gives 2V a fixed SL of "1500" so this will never trigger,
    // but kept as an integrity guard in case the SL constraint changes.
    message(ECO_Version == "2V" && ECO_SnowLoad == "250",
            "Version 2V requires a minimum snow load of SL 500 N/m2. Current selection yields only 250 N/m2.",
            "Error");

    // E300: P*BD/P*OSH/P*OSP + FX thermal release → CO2 advisory
    message((ECO_Control == "P1BD"  || ECO_Control == "P2BD"  ||
             ECO_Control == "P1OSH" || ECO_Control == "P2OSH" ||
             ECO_Control == "P1OSP" || ECO_Control == "P2OSP") &&
            ECO_ThermalRelease == "FX",
            "Control P*BD/P*OSH/P*OSP with thermal release FX: note that a 20g CO2 bottle is normally required for these pressure-locked controls with TVV thermal release.",
            "Warning");

}