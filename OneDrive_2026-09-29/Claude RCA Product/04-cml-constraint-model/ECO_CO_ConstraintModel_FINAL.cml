// ═══════════════════════════════════════════════════════════════════════════
//  ECO Roof Ventilator CO – Constraint Model
//  Nextview Consulting | Revenue Cloud Advanced Configurator
//  v3.0 – action() removed; replaced with proxy variables and constraint(->)
//
//  KEY FIX: action() rules are ONLY for adding/removing bundle RELATIONS
//  (product components). They cannot set attribute values.
//
//  Replacements used:
//    Pure formula  → proxy variable:  decimal(2) Var = expression;
//    Conditional   → implication:     constraint(condition -> Var == value, "msg");
//    Soft default  → preference:      preference(condition -> Var == value, "msg");
// ═══════════════════════════════════════════════════════════════════════════

type LineItem;

type ECORoofVentilatorCO : LineItem {

    // ──────────────────────────────────────────────────────────────────────
    //  INPUT ATTRIBUTES
    // ──────────────────────────────────────────────────────────────────────
    @(defaultValue = "P1BD")
    string ECO_Control = ["HE", "HI", "L", "P1O", "P2O", "P1C", "P2C", "P1O4", "P2O4", "P1C4", "P2C4", "P1BD", "P2BD", "M1B24", "M2B24", "M1C24", "M2C24", "M1O24", "M2O24", "M1B24M", "M2B24M", "M1B24K", "M2B24K", "M1B230", "M2B230", "M1C230", "M2C230", "M1O230", "M2O230", "M1B230J", "M2B230J", "MP1OSH", "MP2OSH", "MP1OSP", "MP2OSP", "M1B24J", "M2B24J", "P1OSH", "P2OSH", "P1OSP", "P2OSP", "P1BDD", "P2BDD", "P1OSHD", "P2OSHD", "P1OSPD", "P2OSPD", "M1C24J", "M2C24J", "M1C230J", "M2C230J"];

